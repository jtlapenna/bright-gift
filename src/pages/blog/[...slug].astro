---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { processAmazonLinks } from '../../utils/processAmazonLinks.js';

export const prerender = true;

// Generate static paths for all content
export async function getStaticPaths() {
  const isPreview = import.meta.env.IS_PREVIEW === 'true';
  const blogPosts = await getCollection('blog', ({ data }) => isPreview || !data.draft);

  const paths = [
    ...blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post, type: post.data.category || 'blog' } }))
  ];

  return paths;
}

const { post, type } = Astro.props;
const { Content } = await post.render();

// Fallbacks for required fields
const fallbackImage = '/images/homepage-banner.webp';
const fallbackTitle = 'Untitled Post';
const fallbackDescription = 'No description available.';
// Modern, robust date fallback: prefer frontmatter date, then pubDate, then today
const fallbackDate = new Date().toISOString().split('T')[0];
const fallbackKeywords = ['gift ideas'];

// Helper to log warnings in dev
function warn(msg) {
  if (import.meta.env.DEV) console.warn(msg);
}

// Validate required fields
const requiredFields = ['title', 'description', 'date', 'image', 'ogImage', 'keywords'];
for (const field of requiredFields) {
  if (!post.data[field]) {
    warn(`[WARN] Missing required frontmatter field: ${field} in post: ${post.slug}`);
  }
}

const title = post.data.title || fallbackTitle;
const metaTitle = post.data.metaTitle; // SEO-optimized title (≤60 chars)
const description = post.data.description || fallbackDescription;
const metaDescription = post.data.metaDescription; // SEO-optimized description (140-160 chars)
const image = post.data.image || fallbackImage;
// Removed automatic .jpg generation to prevent broken image references
// const imageJpg = post.data.imageJpg; // REMOVED - causes 404 errors
const ogImage = post.data.ogImage || image;
const socialImage = post.data.socialImage || ogImage;
const keywords = post.data.keywords || fallbackKeywords;
const date = post.data.date || post.data.pubDate || fallbackDate;

// CRITICAL: Generate canonical URL with HTTPS and trailing slash
// This ensures consistent canonical URLs regardless of how the page was accessed
const postSlug = post.slug;
const canonicalUrl = `https://bright-gift.com/blog/${postSlug}/`;

// Calculate read time based on word count (average reading speed: 200-250 words per minute)
const wordCount = post.body.split(/\s+/).length;
const readTime = post.data.readTime || Math.max(1, Math.ceil(wordCount / 200));

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": {
    "@type": "ImageObject",
    "url": image.startsWith('http') ? image : `https://bright-gift.com${image.startsWith('/') ? '' : '/'}${image}`,
    "width": 1200,
    "height": 630
  },
  "datePublished": date,
  "dateModified": date,
  "author": {
    "@type": "Organization",
    "name": "BrightGift",
    "url": "https://bright-gift.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "BrightGift",
    "url": "https://bright-gift.com/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bright-gift.com/bright-gift-logo.png",
      "width": 512,
      "height": 512
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "articleSection": type === 'gift-guide' ? "Gift Guides" : "Blog",
  "keywords": Array.isArray(keywords) ? keywords.join(', ') : keywords,
  "wordCount": post.body.length,
  "timeRequired": `PT${readTime}M`
};

// Add FAQ schema if available
const faqSchema = post.data.faqSchema;

// Add gift-specific structured data for gift guides
if (type === 'gift-guide' && post.data.affiliateLinks && post.data.affiliateLinks.length > 0) {
  structuredData["@type"] = "ItemList";
  structuredData.numberOfItems = post.data.affiliateLinks.length;
  structuredData.itemListElement = post.data.affiliateLinks.map((link, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Thing", // Changed from Product to Thing - we're not selling these
      "name": link.text,
      "url": link.url,
      "description": `Recommended gift: ${link.text}`
    }
  }));
  
  // REMOVED: Fake aggregate rating data that could cause Google penalties
  // Only add real ratings if you have actual user reviews
  // structuredData.aggregateRating = { ... };
}

// Get related posts
const isPreview = import.meta.env.IS_PREVIEW === 'true';
const allBlogPosts = await getCollection('blog', ({ data }) => isPreview || !data.draft);

// Find related posts based on tags and category
const currentTags = post.data.tags || [];
const currentCategory = post.data.category || 'gift-guides';
const relatedPosts = allBlogPosts
  .filter(p => p.id !== post.id)
  .map(p => {
    const postTags = p.data.tags || [];
    const postCategory = p.data.category || 'gift-guides';
    
    // Calculate relevance score
    let score = 0;
    
    // Tag overlap (higher weight)
    const tagOverlap = postTags.filter(tag => currentTags.includes(tag)).length;
    score += tagOverlap * 3;
    
    // Category match (medium weight)
    if (postCategory === currentCategory) {
      score += 2;
    }
    
    // Title keyword overlap (lower weight)
    const currentTitleWords = post.data.title.toLowerCase().split(/\s+/);
    const postTitleWords = p.data.title.toLowerCase().split(/\s+/);
    const titleOverlap = currentTitleWords.filter(word => 
      word.length > 3 && postTitleWords.includes(word)
    ).length;
    score += titleOverlap;
    
    return { ...p, relevanceScore: score };
  })
  .filter(p => p.relevanceScore > 0)
  .sort((a, b) => b.relevanceScore - a.relevanceScore)
  .slice(0, 2); // Limit to 2 posts to prevent cutoff

// Add related posts structured data
if (relatedPosts.length > 0) {
  structuredData.mentions = relatedPosts.map(relatedPost => ({
    "@type": "Article",
    "headline": relatedPost.data.title,
    "url": `https://bright-gift.com/blog/${relatedPost.slug}/`,
    "description": relatedPost.data.description,
    "datePublished": relatedPost.data.date || relatedPost.data.pubDate,
    "author": {
      "@type": "Organization",
      "name": "BrightGift"
    }
  }));
}
---

<Layout 
  title={title}
  metaTitle={metaTitle}
  description={description}
  metaDescription={metaDescription}
  image={image}
  keywords={keywords}
  canonical={canonicalUrl}
  ogType="article"
  twitterCard="summary_large_image"
  breadcrumbs={[
    { name: "Home", url: "https://bright-gift.com/" },
    { name: "Blog", url: "https://bright-gift.com/blog/" },
    { name: title, url: canonicalUrl }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <!-- FAQ Schema for gift guides -->
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <div class="min-h-screen bg-white">
    <!-- Hero Section -->
    <div class="relative">
      <!-- Hero Image -->
      <div class="h-96 bg-slate-200 relative overflow-hidden">
        <picture>
          {image && image.endsWith('.webp') && <source srcset={image} type="image/webp" />}
          <img 
            src={image || '/images/homepage-banner.webp'} 
            alt={`${title} - Gift guide hero image`}
            class="w-full h-full object-cover"
            loading="eager"
            width="1536" height="1024"
          />
        </picture>
        <div class="absolute inset-0 bg-black bg-opacity-40"></div>
      </div>

      <!-- Hero Content -->
      <div class="absolute inset-0 flex items-center">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
          <!-- Category Badge -->
          <div class="mb-4 flex justify-center">
            <span class="inline-block bg-coral-500 text-white text-base md:text-lg font-semibold px-5 py-2 rounded-full shadow-lg tracking-wide border-2 border-white/40">
              {type === 'gift-guide' ? 'Gift Guide' : type === 'faq' ? 'FAQ' : 'Blog Post'}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Article Content -->
        <div class="lg:col-span-8">

          <!-- Affiliate Disclosure -->
          <div class="mb-4">
            <p class="text-xs text-gray-500 italic">
              This post contains affiliate links. We may earn a commission if you click through and make a purchase, at no additional cost to you.
            </p>
          </div>

          <!-- Title, Sub-heading, Date/Read Time -->
          <h1 class="text-4xl md:text-5xl font-bold drop-shadow-lg" style="font-family: 'Poppins', 'Raleway', Arial, sans-serif; color: #1C2E4A;">{title}</h1>
          
          <!-- Meta information with better layout -->
          <div class="flex items-center gap-4 text-sm text-gray-600 mb-6">
            <span class="inline-block bg-[#FF6B6B] text-white px-3 py-1 rounded-full font-semibold tracking-wide">
              {type === 'gift-guide' ? 'Gift Guide' : type === 'faq' ? 'FAQ' : 'Blog Post'}
            </span>
            <div class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span>{new Date(date + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <div class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{readTime} min read</span>
            </div>
          </div>
          
          <p class="text-xl md:text-2xl text-gray-700 max-w-3xl mb-6" style="font-family: 'Inter', 'Open Sans', Arial, sans-serif;">{description}</p>

          <!-- Tags -->
          {post.data.tags && Array.isArray(post.data.tags) && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2" style="margin-bottom: 8.8rem;">
              {post.data.tags.map((tag) => (
                <span class="bg-slate-100 text-slate-700 text-sm px-3 py-1 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <!-- Article Body -->
          <article class="prose prose-lg max-w-none" id="article-content">
            <Content />
            <div class="text-center">
              <a href="https://bright-gift.com/" class="cta-button" target="_blank" rel="noopener">Try the Gift Idea Generator</a>
            </div>
          </article>

          <script is:inline>
            (function run() {
              const transform = () => {
                const root = document.getElementById('article-content');
                if (!root) return;

                // 1) Tidy H3 titles: move trailing parenthetical into a styled span, and strip affiliate network names
                const AFFILIATE_WORDS = /(afrofiliate|amazon|bookshop)/gi;
                root.querySelectorAll('h3').forEach(h3 => {
                  const text = (h3.textContent || '').trim();
                  const match = text.match(/^(.*?)(\s*\(([^)]*)\))$/); // main + (qualifiers)
                  if (!match) return;
                  const main = match[1].trim();
                  const rawQual = (match[3] || '').trim();
                  const cleanedQual = rawQual
                    .replace(AFFILIATE_WORDS, '')           // remove affiliate network names
                    .replace(/[;,:]\s*/g, ' ')             // normalize separators
                    .replace(/\s{2,}/g, ' ')               // collapse spaces
                    .trim();

                  h3.textContent = '';
                  h3.append(document.createTextNode(main + (cleanedQual ? ' ' : '')));
                  if (cleanedQual) {
                    const span = document.createElement('span');
                    span.className = 'qualifier';
                    span.textContent = `(${cleanedQual})`;
                    h3.append(span);
                  }
                });

                // 2) Remove the "Why it's great:" label but keep the text content
                root.querySelectorAll('p').forEach(p => {
                  const firstStrong = p.querySelector('strong:first-child');
                  if (!firstStrong) return;
                  const label = (firstStrong.textContent || '').toLowerCase().trim();
                  if (label.startsWith("why it's great:") || label.startsWith('why it\u2019s great:')) {
                    firstStrong.remove();
                    // remove any leading colon/spaces left behind
                    p.innerHTML = p.innerHTML.replace(/^\s*:?\s*/, '');
                  }
                });
              };

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', transform, { once: true });
              } else {
                transform();
              }
            })();
          </script>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-4 lg:pl-6">
          <div id="sidebar" class="lg:sticky lg:top-8">
            <!-- Share Buttons -->
            <div class="bg-slate-50 p-6 rounded-lg mb-6 shadow-md">
              <h4 class="font-semibold text-slate-900 mb-3">Share this post</h4>
              <div class="flex gap-2 flex-wrap justify-center">
                <!-- X (Twitter) -->
                <a 
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}&via=Bright_Gift_AI`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Share on X (Twitter)"
                  class="p-2 bg-black text-white rounded hover:bg-gray-800 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <!-- Facebook -->
                <a 
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Share on Facebook"
                  class="p-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <!-- Pinterest -->
                <a 
                  href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(canonicalUrl)}&media=${encodeURIComponent(image)}&description=${encodeURIComponent(title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Share on Pinterest"
                  class="p-2 bg-red-500 text-white rounded hover:bg-red-600 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.746-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/>
                  </svg>
                </a>
                <!-- Instagram -->
                <a 
                  href={`https://www.instagram.com/bright_gift_ai/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Follow us on Instagram"
                  class="p-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded hover:from-purple-600 hover:to-pink-600 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </a>
                <!-- Bluesky -->
                <a 
                  href={`https://bsky.app/profile/brightgift.bsky.social`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Follow us on Bluesky"
                  class="p-2 bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Related Posts -->
            <div class="mb-6">
              <h4 class="font-semibold text-slate-900 mb-4">Related Posts</h4>
              {relatedPosts.length > 0 ? (
                <div class="space-y-3">
                  {relatedPosts.map(relatedPost => (
                    <a 
                      href={`/blog/${relatedPost.slug}`}
                      class="block bg-white rounded-lg border border-slate-200 hover:border-slate-300 transition-all hover:shadow-md overflow-hidden"
                    >
                      <!-- Banner Image -->
                      <div class="aspect-video bg-slate-200 relative overflow-hidden">
                        <img 
                          src={relatedPost.data.image} 
                          alt={`${relatedPost.data.title} - Related post`}
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                      <!-- Content -->
                      <div class="p-3">
                        <h5 class="font-semibold text-slate-900 text-sm mb-1 line-clamp-2">
                          {relatedPost.data.title}
                        </h5>
                        <p class="text-slate-600 text-xs line-clamp-2 mb-2">
                          {relatedPost.data.description}
                        </p>
                        <div class="flex items-center justify-between text-xs text-slate-500">
                          <span>{new Date(relatedPost.data.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                          <span class="text-[#FF6B6B] font-medium">Read More →</span>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="text-center py-4">
                  <p class="text-slate-600 text-sm mb-3">
                    Check out our latest gift guides and ideas!
                  </p>
                  <a 
                    href="/blog"
                    class="inline-block px-4 py-2 bg-[#FF6B6B] text-white text-sm rounded-lg hover:bg-[#ff4c4c] transition-colors"
                  >
                    Browse All Posts
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  html, body {
    font-family: 'Inter', 'Open Sans', Arial, sans-serif;
    color: #333333;
    background: #fff;
  }
  .prose {
    color: #333333;
    font-family: 'Inter', 'Open Sans', Arial, sans-serif;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    font-family: 'Poppins', 'Raleway', Arial, sans-serif;
    color: #1C2E4A;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .prose h1 {
    font-size: 2.5rem;
  }
  .prose h2 {
    font-size: 2rem;
  }
  .prose h3 {
    font-size: 1.35rem;
    margin-top: 2.75rem; /* more separation between items */
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }
  :global(.prose h3) { /* ensure style is not scoped away */
    font-size: 1.35rem;
    margin-top: 2.75rem !important; /* enforce item separation */
    margin-bottom: 0.35rem !important;
    line-height: 1.25 !important;
  }
  .prose h3 .qualifier {
    font-size: 0.82em;
    font-style: italic;
    color: #475569; /* slate-600 */
    margin-left: .3em;
    opacity: .85;
  }
  :global(.prose h3 .qualifier) {
    font-size: 0.82em !important;
    font-style: italic !important;
    color: #475569 !important;
    margin-left: .3em !important;
    opacity: .85 !important;
  }
  .prose a {
    color: #ea580c;
    text-decoration: underline;
    font-weight: 600;
    background: linear-gradient(90deg, #fef3c7 60%, #f59e42 100%);
    border-radius: 0.2em;
    padding: 0.05em 0.2em;
    transition: background 0.2s, color 0.2s;
  }
  .prose a:hover {
    color: #fff;
    background: #FF6B6B;
  }
