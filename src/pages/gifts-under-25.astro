const faqs = [
	{
		question: 'What makes a good gift under $25?',
		answer: 'Choose a gift with one clear job: daily use, comfort, snackable enjoyment, desk utility, or a small personal upgrade. Avoid cheap novelty items that add clutter.'
	},
	{
		question: 'Are gifts under $25 too cheap?',
		answer: 'No. For coworkers, casual friends, teachers, Secret Santa, and stocking stuffers, under $25 is often the right range.'
	}
];
---

<GiftHubPage
	title="Gifts Under $25"
	metaTitle="Gifts Under $25 | BrightGift"
	description="Find gifts under $25 for coworkers, Secret Santa, teachers, stocking stuffers, and casual friends with prefilled BrightGift AI gift finder paths."
	canonicalPath="/gifts-under-25/"
	eyebrow="Budget gift finder"
	heroTitle="Gifts under $25 that still feel considered."
	intro="Under $25 works best when the gift is useful, consumable, cozy, or specific to a daily routine. Use this page for coworkers, Secret Santa, teachers, stocking stuffers, and casual recipients where thoughtful matters more than expensive."
	updatedAt="2026-07-02"
	keywords={['gifts under 25', 'best gifts under 25', 'gifts under $25', 'Secret Santa gifts under 25', 'coworker gifts under 25']}
	ctaVariant="gifts_under_25"
	primaryCtaLabel="Find gifts under $25"
	primaryCtaHref={heroHref}
	footerCtaHref={heroHref}
	experimentId={experimentId}
	generatorPromptTitle="Pick the $25 gift situation"
	generatorPromptDescription="A small budget works better when the recipient context is clear."
	generatorPrompts={[
		{ title: 'Coworker gifts under $25', description: 'Office-safe gifts for teammates, managers, or work friends.', href: coworkerHref, ctaVariant: 'coworker_under_25', label: 'Coworker' },
		{ title: 'Stocking stuffers under $25', description: 'Small holiday gifts that feel useful or cozy.', href: stockingHref, ctaVariant: 'stocking_stuffer_under_25', label: 'Stocking' },
		{ title: 'Teacher gifts under $25', description: 'Practical appreciation gifts that avoid clutter.', href: teacherHref, ctaVariant: 'teacher_under_25', label: 'Teacher' }
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
