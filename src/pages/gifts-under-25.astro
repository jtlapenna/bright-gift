const sections = [
	{
		title: 'Best uses for a $25 gift budget',
		description: 'At this price, the strongest gifts are practical, consumable, cozy, or a small upgrade to something they already use.',
		links: [
			{
				title: 'Coworker gifts under $25',
				description: 'Desk, coffee, snack, and office-friendly ideas that do not feel too personal.',
				href: coworkerHref,
				label: 'Open finder',
				tags: ['coworker', 'office', 'practical']
			},
			{
				title: 'Stocking stuffers under $25',
				description: 'Small cozy, useful, edible, or gadget-style gifts for holiday lists.',
				href: '/stocking-stuffers-under-25/',
				label: 'Stocking hub',
				tags: ['stocking stuffer', 'holiday', 'small']
			},
			{
				title: 'White elephant gifts under $25',
				description: 'Gift-exchange ideas when the room wants funny, useful, and easy-to-steal picks.',
				href: '/white-elephant-gifts-under-25/',
				label: 'White elephant',
				tags: ['white elephant', 'exchange', 'funny']
			},
			{
