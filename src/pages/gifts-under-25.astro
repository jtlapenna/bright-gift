---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-gifts-under-25-202606';

const heroHref = buildGeneratorPrefillHref({
	recipient: 'coworker, friend, teacher, or casual gift recipient',
	interests: 'small gifts, useful gifts, coffee, desk, cozy, snacks, books, self-care',
	budget: 25,
	styles: 'practical,thoughtful',
	sourceCta: 'under_25_hero',
	sourceVariant: 'gifts_under_25',
	sourceExperiment: experimentId
});

const coworkerHref = buildGeneratorPrefillHref({
	recipient: 'coworker',
	interests: 'desk accessories, coffee, snacks, office comfort, useful small gifts',
	budget: 25,
	styles: 'practical,quirky',
	sourceCta: 'under_25_prompt',
	sourceVariant: 'coworker_under_25',
	sourceExperiment: experimentId
});

const stockingHref = buildGeneratorPrefillHref({
	recipient: 'family member',
	interests: 'stocking stuffers, cozy gifts, snacks, small gadgets, self-care',
	budget: 25,
	styles: 'thoughtful,cozy',
	sourceCta: 'under_25_prompt',
	sourceVariant: 'stocking_stuffer_under_25',
	sourceExperiment: experimentId
});

const teacherHref = buildGeneratorPrefillHref({
	recipient: 'teacher',
	interests: 'classroom, coffee, desk, thank you gifts, useful supplies',
	budget: 25,
	styles: 'practical,thoughtful',
	sourceCta: 'under_25_prompt',
	sourceVariant: 'teacher_under_25',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Gifts under $25 for coworkers',
		description: 'Office-safe picks for teammates, managers, Secret Santa, and casual work gifts.',
