				tags: ['budget', 'friend', 'family']
			},
			{
				title: 'Last-minute gift ideas',
				description: 'Fast ideas when delivery or timing matters more than deep personalization.',
				href: '/last-minute-gift-ideas/',
				label: 'Fast path',
				tags: ['last minute', 'quick', 'backup']
			}
		]
	}
