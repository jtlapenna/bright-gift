const faqs = [
	{
		question: 'How should I start a holiday gift list?',
		answer: 'Start by grouping people by relationship and budget. Then add one real clue for each person: a hobby, routine, problem, favorite category, or delivery constraint.'
	},
	{
		question: 'When should I use the BrightGift generator for holiday gifts?',
		answer: 'Use the generator when the broad guide is close but not specific enough. The best prompt includes recipient, budget, occasion, and two interests.'
	}
];
---

<GiftHubPage
	title="Holiday Gift Ideas"
	metaTitle="Holiday Gift Ideas | BrightGift AI Gift Finder"
	description="Find holiday gift ideas by recipient, budget, occasion, and interest. Start with Christmas gifts, Secret Santa gifts, coworker gifts, parent gifts, and prefilled BrightGift generator paths."
	canonicalPath="/holiday-gift-ideas/"
	eyebrow="Holiday gift finder"
	heroTitle="Holiday gift ideas by recipient, budget, and last-minute reality."
	intro="Use this as the Q4 starting point for Christmas gifts, Secret Santa, gifts for parents, coworker gifts, girlfriend gifts, and last-minute holiday shopping. Choose a guide when you know the lane, or open a prefilled BrightGift prompt when you need a faster shortlist."
	keywords={['holiday gift ideas', 'Christmas gift ideas', 'Secret Santa gifts', 'gifts for coworkers', 'gifts for parents', 'last minute gifts', 'AI gift finder']}
	ctaVariant="holiday_general_under_75"
	primaryCtaLabel="Open the holiday gift finder"
	primaryCtaHref={holidayHeroHref}
	footerCtaHref={holidayFooterHref}
	experimentId={experimentId}
	generatorPromptTitle="Start with a holiday shopping scenario"
	generatorPromptDescription="These paths turn the most common Q4 shopping jobs into prefilled generator prompts. Add one personal clue on the homepage to tighten the results."
	generatorPrompts={[
		{
			title: 'Girlfriend holiday gifts under $50',
			description: 'Romantic, cozy, beauty, and keepsake gift ideas with a clear budget.',
			href: girlfriendPromptHref,
			ctaVariant: 'holiday_girlfriend_under_50',
			label: 'Girlfriend'
		},
		{
			title: 'Coworker or Secret Santa under $25',
			description: 'Office-safe, low-pressure gifts for work exchanges and team appreciation.',
			href: coworkerPromptHref,
			ctaVariant: 'holiday_coworker_secret_santa_under_25',
			label: 'Secret Santa'
		},
		{
			title: 'Holiday gifts for parents under $75',
			description: 'Cozy, practical, kitchen, comfort, and family-memory gift ideas.',
			href: parentPromptHref,
			ctaVariant: 'holiday_parent_under_75',
			label: 'Parents'
		},
		{
			title: 'Remote worker gifts under $50',
			description: 'Home-office, desk comfort, coffee, and focus gifts for WFH routines.',
			href: remoteWorkerPromptHref,
			ctaVariant: 'holiday_remote_worker_under_50',
			label: 'Remote work'
		}
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
