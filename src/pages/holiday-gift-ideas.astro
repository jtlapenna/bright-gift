---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-generator-search-entry-202606';
const holidayHeroHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'holiday gifts, Christmas gifts, cozy gifts, useful gifts, personal interests',
	budget: 75,
	styles: 'thoughtful,practical',
	sourceCta: 'holiday_hub_hero',
	sourceVariant: 'holiday_general_under_75',
	sourceExperiment: experimentId
});
const holidayFooterHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'holiday gift list, Christmas gifts, budget, relationship, hobbies',
	budget: 75,
	styles: 'thoughtful,unique',
	sourceCta: 'holiday_hub_footer',
	sourceVariant: 'holiday_general_under_75',
	sourceExperiment: experimentId
});
const girlfriendPromptHref = buildGeneratorPrefillHref({
	recipient: 'girlfriend',
	interests: 'holiday gifts, romantic gifts, cozy nights in, beauty, keepsakes',
	budget: 50,
	styles: 'thoughtful,luxury',
	sourceCta: 'holiday_hub_prompt',
	sourceVariant: 'holiday_girlfriend_under_50',
	sourceExperiment: experimentId
});
const coworkerPromptHref = buildGeneratorPrefillHref({
	recipient: 'coworker',
	interests: 'Secret Santa, office gift, coffee, desk setup, useful small gifts',
	budget: 25,
	styles: 'practical,quirky',
	sourceCta: 'holiday_hub_prompt',
	sourceVariant: 'holiday_coworker_secret_santa_under_25',
	sourceExperiment: experimentId
});
const parentPromptHref = buildGeneratorPrefillHref({
	recipient: 'parent',
	interests: 'holiday gifts for parents, cozy gifts, kitchen, family memories, useful upgrades',
	budget: 75,
	styles: 'thoughtful,practical',
	sourceCta: 'holiday_hub_prompt',
	sourceVariant: 'holiday_parent_under_75',
	sourceExperiment: experimentId
});
const remoteWorkerPromptHref = buildGeneratorPrefillHref({
	recipient: 'remote worker',
	interests: 'holiday gifts, home office, desk setup, coffee, focus, comfort',
	budget: 50,
	styles: 'practical,techy',
	sourceCta: 'holiday_hub_prompt',
	sourceVariant: 'holiday_remote_worker_under_50',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Christmas gifts for girlfriend',
		description: 'Romantic, cozy, practical, and personal holiday gift paths for your partner.',
		href: '/christmas-gifts-for-girlfriend/',
		label: 'Girlfriend',
		tags: ['Christmas', 'girlfriend', 'romantic']
	},
	{
		title: 'Last-minute gift ideas',
		description: 'A faster route when shipping time is short or you need a stronger shortlist today.',
		href: '/last-minute-gift-ideas/',
		label: 'Fast path',
		tags: ['last minute', 'fast shipping', 'generator']
	},
	{
		title: 'Secret Santa gifts',
		description: 'Office-safe, funny, cozy, and low-pressure gifts for work exchanges.',
