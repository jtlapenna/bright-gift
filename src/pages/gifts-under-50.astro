---
import Layout from '../layouts/Layout.astro';

const metaDescription = "Find amazing gifts under $50 with our AI gift finder. Get personalized, thoughtful gift recommendations that fit your budget perfectly.";
---

<Layout 
	title="Gifts Under $50 | AI Gift Finder"
	description={metaDescription}
	canonical="https://bright-gift.com/gifts-under-50/"
>
	<main class="font-sans text-gray-800 dark:text-gray-200">
		<section class="py-20 px-4 bg-gradient-to-br from-[#FEF2D3] to-[#FFDE59]/30">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl md:text-5xl font-bold font-poppins text-[#1C2E4A] mb-6">
					💰 Gifts Under $50
				</h1>
				<p class="text-lg md:text-xl text-[#1C2E4A] mb-8 leading-relaxed">
					Great gifts don't have to be expensive. Our AI finds thoughtful, personalized gifts under $50 that look and feel more expensive than they are.
				</p>
				
				<div class="bg-white/90 rounded-2xl p-8 shadow-lg mb-8">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">Why $50 is the Sweet Spot:</h2>
					<ul class="text-left text-[#1C2E4A] space-y-3 max-w-2xl mx-auto">
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">✓</span>
							<span>Thoughtful without being over-the-top</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">✓</span>
							<span>Perfect for friends, coworkers, and family</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">✓</span>
							<span>Enough budget for quality gifts</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">✓</span>
							<span>Won't make anyone uncomfortable</span>
						</li>
					</ul>
				</div>
				
				<div class="bg-gradient-to-r from-[#A3E4DB] to-[#B8E8E0] rounded-2xl p-8 shadow-lg">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">Find Budget-Friendly Gifts</h2>
					<p class="text-[#1C2E4A] mb-6">
						Our AI suggests gifts that maximize impact while staying within your budget. Every recommendation is under $50 and personally tailored.
					</p>
					<a href="/#tool" class="inline-block bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-lg">
						Find Gifts Under $50 →
					</a>
				</div>
			</div>
		</section>
		
		<section class="py-16 px-4 bg-white">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-[#1C2E4A] mb-4">Use the AI Gift Finder Above</h2>
				<p class="text-lg text-[#1C2E4A] mb-8">
					Set your budget to "Under $50" and get personalized gift ideas instantly.
				</p>
				<a href="/#tool" class="inline-block bg-[#A3E4DB] hover:bg-[#8cd4ca] text-[#1C2E4A] font-bold py-3 px-8 rounded-full transition-colors text-lg shadow">
					Try the AI Gift Finder
				</a>
			</div>
		</section>
	</main>
</Layout>

