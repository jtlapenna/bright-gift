const faqs = [
	{
		question: 'What are good gifts for coworkers under $25?',
		answer: 'The safest coworker gifts under $25 are practical, consumable, or desk-friendly: coffee or tea samplers, snack boxes, insulated mugs, small organizers, notebooks, low-maintenance plants, and useful workday comfort items.'
	},
	{
		question: 'How much should I spend on a coworker gift?',
		answer: 'For most coworkers, $15 to $25 is enough. It feels thoughtful without making the exchange uncomfortable, especially for birthdays, thank-yous, Secret Santa, or casual appreciation.'
	},
	{
		question: 'What coworker gifts should I avoid?',
		answer: 'Avoid clothing sizes, perfume, political jokes, intimate gifts, alcohol unless you know it is welcome, and anything that creates desk clutter or awkward attention.'
	}
];
---

<GiftHubPage
	title="Gifts for Coworkers Under $25"
	metaTitle="Gifts for Coworkers Under $25 | BrightGift"
	description="Find gifts for coworkers under $25, including safe office gifts, Secret Santa gifts, manager gifts, remote coworker gifts, and practical desk-friendly ideas."
	canonicalPath="/gifts-for-coworkers-under-25/"
	eyebrow="Workplace gift finder"
	heroTitle="Coworker gifts under $25 that feel thoughtful, not awkward."
	intro="Coworker gifts work best when they are useful, modest, and easy to enjoy at work. Start with the exact office relationship, then use the BrightGift finder or the Amazon-linked guide to move from idea to purchase."
	updatedAt="2026-07-02"
	keywords={['gifts for coworkers under $25', 'coworker gifts under 25', 'gifts under 25 for coworkers', 'office gifts under 25', 'Secret Santa gifts for coworkers under 25']}
	ctaVariant="coworker_under_25"
	primaryCtaLabel="Find coworker gifts under $25"
	primaryCtaHref={heroHref}
	footerCtaHref={heroHref}
	experimentId={experimentId}
	generatorPromptTitle="Choose the coworker gift situation"
	generatorPromptDescription="The right $25 gift changes depending on whether this is a manager, remote teammate, Secret Santa exchange, or a coworker you barely know."
	generatorPrompts={[
		{ title: 'Safe coworker gifts under $25', description: 'Practical, low-pressure ideas for someone you do not know well.', href: safeCoworkerHref, ctaVariant: 'safe_coworker_under_25', label: 'Safe' },
		{ title: 'Manager gifts under $25', description: 'Modest, professional ideas for a team lead or supervisor.', href: managerHref, ctaVariant: 'manager_under_25', label: 'Manager' },
		{ title: 'Remote coworker gifts under $25', description: 'Work-from-home desk, coffee, snack, and comfort ideas.', href: remoteCoworkerHref, ctaVariant: 'remote_coworker_under_25', label: 'Remote' },
		{ title: 'Coworker Secret Santa gifts', description: 'Office-safe exchange gifts that stay within the usual budget.', href: secretSantaHref, ctaVariant: 'secret_santa_coworker_under_25', label: 'Secret Santa' },
		{ title: 'Last-minute coworker gifts', description: 'Quick, practical ideas when the office gift deadline is close.', href: lastMinuteHref, ctaVariant: 'last_minute_coworker_under_25', label: 'Last minute' }
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
