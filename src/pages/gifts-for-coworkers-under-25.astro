---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-coworker-under-25-202606';

const heroHref = buildGeneratorPrefillHref({
	recipient: 'coworker, teammate, manager, or Secret Santa recipient',
	interests: 'desk accessories, coffee, tea, snacks, office comfort, practical work gifts, low-pressure gifts',
	budget: 25,
	styles: 'practical,thoughtful',
	sourceCta: 'coworker_under_25_hero',
	sourceVariant: 'coworker_under_25',
	sourceExperiment: experimentId
});

const safeCoworkerHref = buildGeneratorPrefillHref({
	recipient: 'coworker I do not know well',
	interests: 'coffee, tea, snacks, desk accessories, office supplies, useful small gifts',
	budget: 25,
	styles: 'practical,thoughtful',
	sourceCta: 'coworker_under_25_prompt',
	sourceVariant: 'safe_coworker_under_25',
	sourceExperiment: experimentId
});

const managerHref = buildGeneratorPrefillHref({
	recipient: 'manager or team lead',
	interests: 'coffee, notebooks, desk organization, professional accessories, useful office gifts',
	budget: 25,
	styles: 'professional,thoughtful',
	sourceCta: 'coworker_under_25_prompt',
	sourceVariant: 'manager_under_25',
	sourceExperiment: experimentId
});

const remoteCoworkerHref = buildGeneratorPrefillHref({
	recipient: 'remote coworker',
	interests: 'home office, coffee, desk comfort, snacks, video call setup, small useful gifts',
	budget: 25,
	styles: 'practical,cozy',
	sourceCta: 'coworker_under_25_prompt',
	sourceVariant: 'remote_coworker_under_25',
	sourceExperiment: experimentId
});

const secretSantaHref = buildGeneratorPrefillHref({
	recipient: 'coworker for Secret Santa',
	interests: 'office gift exchange, snacks, coffee, desk accessories, cozy winter gifts, safe funny gifts',
	budget: 25,
	styles: 'practical,quirky',
	sourceCta: 'coworker_under_25_prompt',
	sourceVariant: 'secret_santa_coworker_under_25',
	sourceExperiment: experimentId
});
const lastMinuteHref = buildGeneratorPrefillHref({
	recipient: 'coworker',
	interests: 'last-minute coworker gifts, coffee, snacks, desk accessories, digital gifts, local pickup',
	budget: 25,
	styles: 'practical,thoughtful',
	sourceCta: 'coworker_under_25_prompt',
	sourceVariant: 'last_minute_coworker_under_25',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Coworker gift guide with Amazon links',
