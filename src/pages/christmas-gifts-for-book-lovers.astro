---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-christmas-book-lover-gifts-202607';

const heroHref = buildGeneratorPrefillHref({
	recipient: 'book lover',
	interests: 'Christmas gifts for book lovers, cozy reading gifts, personalized book gifts, reading journal, book light, book sleeve',
	budget: 50,
	styles: 'cozy,personalized',
	sourceCta: 'christmas_book_hero',
	sourceVariant: 'christmas_book_gifts_under_50',
	sourceExperiment: experimentId
});

const girlfriendHref = buildGeneratorPrefillHref({
	recipient: 'girlfriend who loves books',
	interests: 'Christmas gifts for book lovers, romance books, cozy reading gifts, custom bookmark, reading journal',
	budget: 75,
	styles: 'romantic,cozy',
	sourceCta: 'christmas_book_prompt',
	sourceVariant: 'christmas_book_gifts_girlfriend',
	sourceExperiment: experimentId
});

const coworkerHref = buildGeneratorPrefillHref({
	recipient: 'coworker who reads',
	interests: 'book light, notebook, desk book stand, book sleeve, reading journal, coffee',
	budget: 25,
	styles: 'practical,office-safe',
	sourceCta: 'christmas_book_prompt',
	sourceVariant: 'coworker_book_gifts_under_25',
	sourceExperiment: experimentId
});

const lastMinuteHref = buildGeneratorPrefillHref({
	recipient: 'book lover',
	interests: 'last-minute book gifts, fast shipping, audiobook gift, bookstore gift card, reading accessories',
	budget: 50,
	styles: 'practical,cozy',
	sourceCta: 'christmas_book_prompt',
	sourceVariant: 'last_minute_book_gifts',
	sourceExperiment: experimentId
});

const personalizedHref = buildGeneratorPrefillHref({
	recipient: 'book lover',
	interests: 'custom bookplates, book stamp, personalized bookmark, reading journal, custom library gift',
	budget: 50,
	styles: 'personalized,cozy',
	sourceCta: 'christmas_book_prompt',
	sourceVariant: 'personalized_book_gifts',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Personalized book gifts',
		description: 'Custom bookplates, book stamps, reading journals, bookmarks, and safer personalized reader gifts.',
		href: '/personalized-book-gifts/',
		label: 'Personalized',
		tags: ['books', 'custom', 'reader']
	},
	{
		title: 'Gifts for book lovers under $50',
		description: 'A product-guide path for reading accessories, cozy upgrades, and book-adjacent gifts.',
		href: '/blog/gifts-for-book-lovers-under-50/',
