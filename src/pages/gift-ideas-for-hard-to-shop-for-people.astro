---
import Layout from '../layouts/Layout.astro';

const metaDescription = "Struggling to find gifts for people who have everything? Use our free AI gift finder to discover unique, personalized gift ideas for even the hardest-to-shop-for people.";
---

<Layout 
	title="Gift Ideas for Hard-to-Shop-For People | AI Gift Finder"
	description={metaDescription}
	canonical="https://bright-gift.com/gift-ideas-for-hard-to-shop-for-people/"
>
	<main class="font-sans text-gray-800 dark:text-gray-200">
		<section class="py-20 px-4 bg-gradient-to-br from-[#FEF2D3] to-[#FFDE59]/30">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl md:text-5xl font-bold font-poppins text-[#1C2E4A] mb-6">
					Gift Ideas for Hard-to-Shop-For People
				</h1>
				<p class="text-lg md:text-xl text-[#1C2E4A] mb-8 leading-relaxed">
					We all know someone who's impossible to buy for—the person who has everything, never drops hints, or has very specific tastes. Our AI gift finder solves this problem by analyzing their interests and suggesting unique, thoughtful gifts they'll actually love.
				</p>
				
				<div class="bg-white/90 rounded-2xl p-8 shadow-lg mb-8">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">Why People Are Hard to Shop For:</h2>
					<ul class="text-left text-[#1C2E4A] space-y-3 max-w-2xl mx-auto">
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">•</span>
							<span>They already have everything they need</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">•</span>
							<span>They have very specific or niche interests</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">•</span>
							<span>They never share what they want</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">•</span>
							<span>You don't know them well enough yet</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">•</span>
							<span>They're minimalists who don't want more stuff</span>
						</li>
					</ul>
				</div>
				
				<div class="bg-gradient-to-r from-[#A3E4DB] to-[#B8E8E0] rounded-2xl p-8 shadow-lg">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">How Our AI Gift Finder Helps:</h2>
					<p class="text-[#1C2E4A] mb-6">
						Instead of spending hours browsing generic gift guides, our AI analyzes what you know about the person—their hobbies, lifestyle, recent changes—and suggests creative, unexpected gifts that match their personality.
					</p>
					<a href="/#tool" class="inline-block bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-lg">
						Find the Perfect Gift Now →
					</a>
				</div>
			</div>
		</section>
		
		<!-- Tool Section (embedded) -->
		<section class="py-16 px-4 bg-white">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-[#1C2E4A] mb-4">Use the AI Gift Finder Above</h2>
				<p class="text-lg text-[#1C2E4A] mb-8">
					Enter what you know about the person, and our AI will suggest unique gifts they'll love.
				</p>
				<a href="/#tool" class="inline-block bg-[#A3E4DB] hover:bg-[#8cd4ca] text-[#1C2E4A] font-bold py-3 px-8 rounded-full transition-colors text-lg shadow">
					Try the AI Gift Finder
				</a>
			</div>
		</section>
	</main>
</Layout>

