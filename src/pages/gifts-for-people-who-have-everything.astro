---
import Layout from '../layouts/Layout.astro';

const metaDescription = "What do you get someone who has everything? Our AI gift finder suggests unique, experiential, and personalized gifts they don't already own.";
---

<Layout 
	title="Gifts for People Who Have Everything | AI Gift Finder"
	description={metaDescription}
	canonical="https://bright-gift.com/gifts-for-people-who-have-everything/"
>
	<main class="font-sans text-gray-800 dark:text-gray-200">
		<section class="py-20 px-4 bg-gradient-to-br from-[#FEF2D3] to-[#FFDE59]/30">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl md:text-5xl font-bold font-poppins text-[#1C2E4A] mb-6">
					Gifts for People Who Have Everything
				</h1>
				<p class="text-lg md:text-xl text-[#1C2E4A] mb-8 leading-relaxed">
					When someone already owns everything they need, traditional gifts fall flat. Our AI suggests experiences, personalized items, and unique finds they don't have yet.
				</p>
				
				<div class="bg-white/90 rounded-2xl p-8 shadow-lg mb-8">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">What Works for People Who Have Everything:</h2>
					<ul class="text-left text-[#1C2E4A] space-y-3 max-w-2xl mx-auto">
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎭</span>
							<span><strong>Experiences</strong> - Concert tickets, classes, adventures</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">✨</span>
							<span><strong>Personalized items</strong> - Custom art, engraved pieces</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🌱</span>
							<span><strong>Consumables</strong> - Gourmet food, wine, specialty items</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">💝</span>
							<span><strong>Charitable donations</strong> - In their name to causes they care about</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎨</span>
							<span><strong>Handmade/artisan goods</strong> - One-of-a-kind pieces</span>
						</li>
					</ul>
				</div>
				
				<div class="bg-gradient-to-r from-[#A3E4DB] to-[#B8E8E0] rounded-2xl p-8 shadow-lg">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">Let AI Find the Perfect Gift</h2>
					<p class="text-[#1C2E4A] mb-6">
						Tell us about their interests and lifestyle. Our AI will suggest creative, unexpected gifts that go beyond the usual options.
					</p>
					<a href="/#tool" class="inline-block bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-lg">
						Find Unique Gifts Now →
					</a>
				</div>
			</div>
		</section>
		
		<section class="py-16 px-4 bg-white">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-[#1C2E4A] mb-4">Use the AI Gift Finder Above</h2>
				<p class="text-lg text-[#1C2E4A] mb-8">
					Enter their interests and let AI suggest gifts they don't already have.
				</p>
				<a href="/#tool" class="inline-block bg-[#A3E4DB] hover:bg-[#8cd4ca] text-[#1C2E4A] font-bold py-3 px-8 rounded-full transition-colors text-lg shadow">
					Try the AI Gift Finder
				</a>
			</div>
		</section>
	</main>
</Layout>

