---
import Layout from '../layouts/Layout.astro';

const metaDescription = "Need a gift fast? Our AI gift finder generates personalized last-minute gift ideas in under 60 seconds. No more panic buying—find thoughtful gifts instantly.";
---

<Layout 
	title="Last-Minute Gift Ideas | AI Gift Finder"
	description={metaDescription}
	canonical="https://bright-gift.com/last-minute-gift-ideas/"
>
	<main class="font-sans text-gray-800 dark:text-gray-200">
		<section class="py-20 px-4 bg-gradient-to-br from-[#FEF2D3] to-[#FFDE59]/30">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl md:text-5xl font-bold font-poppins text-[#1C2E4A] mb-6">
					⏰ Last-Minute Gift Ideas
				</h1>
				<p class="text-lg md:text-xl text-[#1C2E4A] mb-8 leading-relaxed">
					Forgot someone's birthday? Party tonight? No problem. Our AI gift finder generates personalized gift ideas in under 60 seconds—no more panic buying generic gifts.
				</p>
				
				<div class="bg-white/90 rounded-2xl p-8 shadow-lg mb-8">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">Perfect for:</h2>
					<ul class="text-left text-[#1C2E4A] space-y-3 max-w-2xl mx-auto">
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎂</span>
							<span>Birthdays you forgot about</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎉</span>
							<span>Last-minute party invitations</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎄</span>
							<span>Holiday shopping procrastination</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">💝</span>
							<span>Same-day gift needs</span>
						</li>
					</ul>
				</div>
				
				<div class="bg-gradient-to-r from-[#FF6B6B] to-[#ff4c4c] rounded-2xl p-8 shadow-lg text-white">
					<h2 class="text-2xl font-bold mb-4">Get Gift Ideas in 60 Seconds</h2>
					<p class="mb-6">
						Enter who you're shopping for and their interests. Our AI instantly suggests thoughtful gifts you can order today.
					</p>
					<a href="/#tool" class="inline-block bg-white text-[#FF6B6B] font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-lg hover:bg-gray-100">
						Find Last-Minute Gifts Now →
					</a>
				</div>
			</div>
		</section>
		
		<section class="py-16 px-4 bg-white">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-[#1C2E4A] mb-4">Use the AI Gift Finder Above</h2>
				<p class="text-lg text-[#1C2E4A] mb-8">
					Stop stressing. Start finding. Get personalized gift ideas instantly.
				</p>
				<a href="/#tool" class="inline-block bg-[#A3E4DB] hover:bg-[#8cd4ca] text-[#1C2E4A] font-bold py-3 px-8 rounded-full transition-colors text-lg shadow">
					Try the AI Gift Finder
				</a>
			</div>
		</section>
	</main>
</Layout>

