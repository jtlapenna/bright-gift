---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-generator-search-entry-202606';
const occasionHeroHref = buildGeneratorPrefillHref({
	recipient: 'host or celebrant',
	interests: 'occasion gifts, birthday, housewarming, holiday gifts, anniversary',
	budget: 75,
	styles: 'thoughtful,practical',
	sourceCta: 'occasion_hub_hero',
	sourceVariant: 'occasion_hub_generator',
	sourceExperiment: experimentId
});
const occasionFooterHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'upcoming occasion, relationship, budget, useful gifts, personal details',
	budget: 75,
	styles: 'thoughtful,unique',
	sourceCta: 'occasion_hub_footer',
	sourceVariant: 'occasion_hub_generator',
	sourceExperiment: experimentId
});
const holidayPromptHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'holiday gifts, Christmas gifts, cozy gifts, useful gifts, personal interests',
	budget: 75,
	styles: 'thoughtful,practical',
	sourceCta: 'occasion_hub_prompt',
	sourceVariant: 'occasion_holiday_under_75',
	sourceExperiment: experimentId
});
const birthdayPromptHref = buildGeneratorPrefillHref({
	recipient: 'birthday recipient',
	interests: 'birthday gift, hobbies, useful surprise, daily routine',
	budget: 50,
	styles: 'funny,thoughtful',
	sourceCta: 'occasion_hub_prompt',
	sourceVariant: 'occasion_birthday_under_50',
	sourceExperiment: experimentId
});
const housewarmingPromptHref = buildGeneratorPrefillHref({
	recipient: 'new homeowner',
	interests: 'housewarming, kitchen, hosting, cozy home, move-in gift',
	budget: 75,
	styles: 'practical,luxury',
	sourceCta: 'occasion_hub_prompt',
	sourceVariant: 'occasion_housewarming_under_75',
	sourceExperiment: experimentId
});

