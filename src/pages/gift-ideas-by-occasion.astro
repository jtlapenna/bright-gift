const faqs = [
	{
		question: 'Why browse gifts by occasion?',
		answer: 'Occasion changes the acceptable budget, tone, and risk level. A housewarming gift can be practical, while a romantic anniversary gift usually needs more personal meaning.'
	},
	{
		question: 'How should I use the generator for an occasion?',
		answer: 'Add the occasion first, then include relationship, budget, and a few real interests. For example: housewarming gift for close friends under $75 who cook and host.'
	}
];
---

<GiftHubPage
	title="Gift Ideas by Occasion"
	metaTitle="Gift Ideas by Occasion | BrightGift"
	description="Browse BrightGift gift ideas by occasion, including housewarming, birthdays, anniversaries, weddings, Mother's Day, Father's Day, and last-minute gift ideas."
	canonicalPath="/gift-ideas-by-occasion/"
	eyebrow="Browse by moment"
	heroTitle="Gift ideas by occasion, for moments when the gift has to feel right."
	intro="Housewarming gifts, birthday gifts, anniversary gifts, wedding gifts, Mother's Day, Father's Day, and last-minute gifts all ask for a different tone. Choose the moment first, then use the right guide or generator prompt to find something that fits the occasion."
	updatedAt="2026-07-03"
	keywords={['gift ideas by occasion', 'housewarming gifts', 'last minute gift ideas', 'anniversary gifts', 'birthday gift ideas', 'wedding gift ideas']}
	ctaVariant="occasion_hub_generator"
	primaryCtaLabel="Find gifts for an occasion"
	primaryCtaHref={occasionHeroHref}
	footerCtaHref={occasionFooterHref}
	experimentId={experimentId}
	generatorPromptTitle="Start with the occasion, then add the person"
	generatorPromptDescription="These prefilled paths cover the moments with the clearest shopping intent: holidays, birthdays, and housewarming gifts."
	generatorPrompts={[
		{
			title: 'Holiday gifts under $75',
			description: 'A Q4 path for family, friends, coworkers, Christmas, and Secret Santa shopping.',
			href: holidayPromptHref,
			ctaVariant: 'occasion_holiday_under_75',
			label: 'Holiday'
		},
		{
			title: 'Birthday gifts under $50',
			description: 'A flexible path for fast birthday ideas tied to hobbies and daily routines.',
			href: birthdayPromptHref,
			ctaVariant: 'occasion_birthday_under_50',
			label: 'Birthday'
		},
		{
			title: 'Housewarming gifts under $75',
			description: 'A practical path for new homeowners, hosts, kitchen gifts, and cozy-home upgrades.',
			href: housewarmingPromptHref,
			ctaVariant: 'occasion_housewarming_under_75',
			label: 'Housewarming'
		}
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
