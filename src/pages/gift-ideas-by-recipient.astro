const faqs = [
	{
		question: 'How do I choose a gift by recipient?',
		answer: 'Start with the relationship, then choose one specific clue: their routine, hobby, home situation, or the occasion. That keeps the gift from feeling generic.'
	},
	{
		question: 'What if I do not know the person very well?',
		answer: 'Use safer categories like food, desk upgrades, home basics, useful accessories, or the BrightGift generator. Avoid clothing, fragrance, and anything too personal.'
	}
];
---

<GiftHubPage
	title="Gift Ideas by Recipient"
	metaTitle="Gift Ideas by Recipient | BrightGift"
	description="Browse BrightGift gift ideas by recipient, including girlfriends, coworkers, new homeowners, parents, teachers, remote workers, book lovers, gamers, and more."
	canonicalPath="/gift-ideas-by-recipient/"
	eyebrow="Browse by person"
	heroTitle="Gift ideas by recipient, from easy wins to hard-to-shop-for people."
	intro="Start with who you are shopping for: your girlfriend, coworker, new homeowner friend, parent, teacher, book lover, gamer, or the person who already seems to have everything. These recipient gift guides help you find a thoughtful lane faster, then the BrightGift generator can tailor it by budget, occasion, and personality."
	updatedAt="2026-07-02"
	keywords={['gift ideas by recipient', 'gifts for girlfriend', 'coworker gifts', 'gifts for new homeowners', 'gifts for people who have everything', 'personalized gift ideas']}
	ctaVariant="recipient_hub_generator"
	primaryCtaLabel="Find gifts for a specific person"
	primaryCtaHref={recipientHeroHref}
	footerCtaHref={recipientFooterHref}
	experimentId={experimentId}
	generatorPromptTitle="Start with a recipient, then personalize it"
	generatorPromptDescription="These prefilled gift finder paths cover the recipient searches BrightGift is already trying to win: girlfriend gifts, coworker gifts, and housewarming gifts for new homeowners."
	generatorPrompts={[
		{
			title: 'Girlfriend gifts under $50',
			description: 'A prefilled path for romantic, cozy, useful, and beauty-adjacent gift ideas.',
			href: girlfriendPromptHref,
			ctaVariant: 'recipient_girlfriend_under_50',
			label: 'Girlfriend'
		},
		{
			title: 'Coworker gifts under $25',
			description: 'A safer office-gift path for birthdays, Secret Santa, team thanks, and small appreciation gifts.',
			href: coworkerPromptHref,
			ctaVariant: 'recipient_coworker_under_25',
			label: 'Coworker'
		},
		{
			title: 'New homeowner gifts under $75',
			description: 'A practical housewarming path for kitchen, hosting, and cozy-home ideas.',
			href: newHomeownerPromptHref,
			ctaVariant: 'recipient_new_homeowner_under_75',
			label: 'New homeowner'
		}
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
