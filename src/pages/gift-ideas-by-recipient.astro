---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-generator-search-entry-202606';
const recipientHeroHref = buildGeneratorPrefillHref({
	recipient: 'specific gift recipient',
	interests: 'recipient gift ideas, personal style, daily routine, useful gifts',
	budget: 50,
	styles: 'thoughtful,practical',
	sourceCta: 'recipient_hub_hero',
	sourceVariant: 'recipient_hub_generator',
	sourceExperiment: experimentId
});
const recipientFooterHref = buildGeneratorPrefillHref({
	recipient: 'specific gift recipient',
	interests: 'hard-to-shop-for person, hobbies, personal routine, gift occasion',
	budget: 75,
	styles: 'thoughtful,unique',
	sourceCta: 'recipient_hub_footer',
	sourceVariant: 'recipient_hub_generator',
	sourceExperiment: experimentId
});
const girlfriendPromptHref = buildGeneratorPrefillHref({
	recipient: 'girlfriend',
	interests: 'romantic gifts, cozy nights in, beauty, keepsakes',
	budget: 50,
	styles: 'thoughtful,luxury',
	sourceCta: 'recipient_hub_prompt',
	sourceVariant: 'recipient_girlfriend_under_50',
	sourceExperiment: experimentId
});
const coworkerPromptHref = buildGeneratorPrefillHref({
	recipient: 'coworker',
	interests: 'office gift, coffee, desk setup, useful small gifts',
	budget: 25,
	styles: 'practical,quirky',
	sourceCta: 'recipient_hub_prompt',
	sourceVariant: 'recipient_coworker_under_25',
	sourceExperiment: experimentId
});
const newHomeownerPromptHref = buildGeneratorPrefillHref({
	recipient: 'new homeowner',
	interests: 'housewarming, kitchen, hosting, cozy home',
	budget: 75,
	styles: 'practical,luxury',
	sourceCta: 'recipient_hub_prompt',
	sourceVariant: 'recipient_new_homeowner_under_75',
	sourceExperiment: experimentId
});

