				href: '/blog/25-thoughtful-housewarming-gifts-for-new-homeowners-under-75/',
				label: 'Home',
				tags: ['housewarming', 'new homeowners', 'practical']
			},
			{
				title: 'Best home gifts on Amazon',
				description: 'A broader home category guide for decor, organization, kitchen, and comfort ideas.',
				href: '/blog/best-home-gifts-on-amazon-2024/',
				label: 'Home gifts',
				tags: ['home', 'Amazon', 'decor']
			},
			{
				title: 'Remote work and WFH professional gifts',
				description: 'A broader home-office lane for productivity, comfort, and focus.',
				href: '/blog/gifts-for-remote-workers-and-wfh-professionals/',
				label: 'Work from home',
				tags: ['WFH', 'productivity', 'desk']
			},
			{
				title: 'Sleep-tech gifts',
				description: 'Rest and recovery gifts for people who care about better sleep.',
				href: '/blog/sleep-tech-gifts-that-really-work/',
				label: 'Sleep',
				tags: ['wellness', 'sleep', 'tech']
			}
		]
	},
	{
		title: 'Hobby and personality interests',
		description: 'Use these when a hobby gives you a stronger clue than the occasion does.',
		links: [
			{
				title: 'Gifts for plant lovers',
				description: 'Plant care, display, and greenery gifts for indoor gardeners.',
				href: '/blog/gifts-for-plant-lovers/',
				label: 'Plants',
				tags: ['plants', 'home', 'hobby']
			},
			{
				title: 'Gifts for Dungeons and Dragons enthusiasts',
				description: 'Tabletop gifts for players, dungeon masters, and fantasy-loving friends.',
				href: '/blog/gifts-for-dungeons-dragons-enthusiasts-level-up-their-experience/',
				label: 'Tabletop',
				tags: ['D&D', 'gaming', 'hobby']
			},
			{
				title: 'Gifts for board game enthusiasts',
				description: 'Board game and game-night gifts for people who like strategy, groups, and replayability.',
				href: '/blog/unique-gifts-for-board-game-enthusiasts/',
				label: 'Board games',
				tags: ['board games', 'game night', 'hobby']
			},
			{
				title: 'Yoga gifts',
				description: 'Yoga props, recovery accessories, and calming gifts for different practice levels.',
				href: '/blog/top-gifts-for-yoga-enthusiasts-beginners-to-advanced-practitioners/',
				label: 'Yoga',
				tags: ['wellness', 'yoga', 'practice']
			}
		]
	},
	{
		title: 'Values, style, and shopping preferences',
		description: 'Sometimes the best gift clue is not a hobby, but the kind of purchase the recipient respects.',
		links: [
			{
				title: 'Eco-friendly gift ideas',
				description: 'Lower-waste gifts for recipients who care about sustainability.',
				href: '/blog/eco-friendly-gift-ideas-for-every-budget/',
				label: 'Eco-friendly',
				tags: ['sustainable', 'values', 'budget']
			},
			{
				title: 'Clean-girl minimalist gifts',
				description: 'Polished, minimal gifts with personality for style-conscious recipients.',
				href: '/blog/clean-girl-2-0-minimalist-gifts-with-personality/',
				label: 'Minimalist style',
				tags: ['style', 'minimal', 'beauty']
			},
			{
				title: 'Black-owned business gifts',
				description: 'Gift ideas sourced from Black-owned businesses and marketplaces.',
