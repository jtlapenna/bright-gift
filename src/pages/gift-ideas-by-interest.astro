			},
			{
				title: 'Personalized gifts for kids',
				description: 'Custom and personal gift ideas for kids where age, interests, and safety matter.',
				href: '/blog/personalized-gifts-for-kids/',
				label: 'Personalized',
				tags: ['kids', 'personalized', 'family']
			}
		]
	}
];

const faqs = [
	{
		question: 'Why browse gift ideas by interest?',
		answer: 'Interests make gift selection easier because they reveal what the person already spends time on. The safest gifts improve or support an existing hobby instead of forcing a new one.'
	},
	{
		question: 'What if I know several interests?',
		answer: 'Choose the interest with the clearest daily routine or strongest need. If you are unsure, enter all of them into the BrightGift generator and compare the shortlist.'
	}
];
---

<GiftHubPage
	title="Gift Ideas by Interest"
	metaTitle="Gift Ideas by Interest | BrightGift"
	description="Browse BrightGift gift ideas by interest, including book lovers, gamers, plant lovers, pet lovers, remote workers, yoga fans, homebodies, and hobby gifts."
	canonicalPath="/gift-ideas-by-interest/"
	eyebrow="Browse by interest"
	heroTitle="Gift ideas by interest, because hobbies make better clues than guesses."
	intro="If they are a book lover, gamer, plant person, pet lover, remote worker, yoga fan, homebody, or hobby collector, start there. Interest-led gift guides make it easier to choose something they will actually use, not just politely thank you for."
	keywords={['gift ideas by interest', 'gifts for book lovers', 'gifts for gamers', 'gifts for plant lovers', 'work from home gifts', 'hobby gifts']}
	ctaVariant="interest_hub_generator"
	primaryCtaLabel="Find gifts by interest"
	primaryCtaHref={interestHeroHref}
	footerCtaHref={interestFooterHref}
	experimentId={experimentId}
	generatorPromptTitle="Use the hobby as the first clue"
	generatorPromptDescription="These prefilled gift finder paths use interests that already map well to shopping behavior: books, gaming, and remote-work routines."
	generatorPrompts={[
		{
			title: 'Book lover gifts under $50',
			description: 'A cozy path for reading accessories, journals, lights, tea, and book-adjacent picks.',
			href: bookPromptHref,
			ctaVariant: 'interest_book_lover_under_50',
			label: 'Books'
		},
		{
			title: 'Gamer gifts under $50',
			description: 'A lower-risk path for desk, comfort, lighting, controller, and setup upgrades.',
			href: gamerPromptHref,
			ctaVariant: 'interest_gamer_under_50',
			label: 'Gaming'
		},
		{
			title: 'Remote worker gifts under $50',
			description: 'A useful path for home-office comfort, focus, desk, and coffee gifts.',
			href: remoteWorkerPromptHref,
			ctaVariant: 'interest_remote_worker_under_50',
			label: 'Home office'
		}
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
