---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-generator-search-entry-202606';
const interestHeroHref = buildGeneratorPrefillHref({
	recipient: 'hobby lover',
	interests: 'books, games, plants, home office, wellness',
	budget: 50,
	styles: 'practical,quirky',
	sourceCta: 'interest_hub_hero',
	sourceVariant: 'interest_hub_generator',
	sourceExperiment: experimentId
});
const interestFooterHref = buildGeneratorPrefillHref({
	recipient: 'hobby lover',
	interests: 'hobbies, daily routine, favorite activities, useful accessories',
	budget: 50,
	styles: 'thoughtful,practical',
	sourceCta: 'interest_hub_footer',
	sourceVariant: 'interest_hub_generator',
	sourceExperiment: experimentId
});
const bookPromptHref = buildGeneratorPrefillHref({
	recipient: 'book lover',
	interests: 'reading, cozy gifts, book accessories, journals, tea',
	budget: 50,
	styles: 'cozy,thoughtful',
	sourceCta: 'interest_hub_prompt',
	sourceVariant: 'interest_book_lover_under_50',
	sourceExperiment: experimentId
});
const gamerPromptHref = buildGeneratorPrefillHref({
	recipient: 'gamer',
	interests: 'gaming, desk setup, controller accessories, lighting, comfort',
	budget: 50,
	styles: 'techy,practical',
	sourceCta: 'interest_hub_prompt',
	sourceVariant: 'interest_gamer_under_50',
	sourceExperiment: experimentId
});
const remoteWorkerPromptHref = buildGeneratorPrefillHref({
	recipient: 'remote worker',
	interests: 'home office, desk setup, coffee, focus, comfort',
	budget: 50,
	styles: 'practical,techy',
	sourceCta: 'interest_hub_prompt',
	sourceVariant: 'interest_remote_worker_under_50',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Gifts for book lovers',
		description: 'Reading accessories, cozy upgrades, and book-adjacent gifts for people whose shelf is never empty.',
		href: '/blog/gifts-for-book-lovers-under-50/',
		label: 'Book lovers',
		tags: ['books', 'reading', 'under $50']
	},
	{
		title: 'Gifts for gamers',
		description: 'Gaming gift ideas when you know the hobby but not every detail of the setup.',
		href: '/blog/gifts-for-gamers-under-50/',
		label: 'Gamers',
		tags: ['gaming', 'tech', 'desk']
	},
	{
		title: 'Work-from-home gifts',
		description: 'Desk, comfort, and routine upgrades for remote workers and home-office people.',
		href: '/blog/gifts-for-remote-workers-under-50/',
		label: 'Home office',
		tags: ['remote work', 'desk', 'under $50']
	}
];

const sections = [
	{
