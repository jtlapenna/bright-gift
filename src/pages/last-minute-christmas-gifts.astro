---

<GiftHubPage
	title="Last-Minute Christmas Gifts"
	metaTitle="Last-Minute Christmas Gifts | BrightGift"
	description="Find last-minute Christmas gifts by recipient, budget, delivery risk, and relationship, with prefilled BrightGift AI gift finder paths for fast holiday shopping."
	canonicalPath="/last-minute-christmas-gifts/"
	eyebrow="Last-minute Christmas finder"
	heroTitle="Last-minute Christmas gifts that still feel considered."
	intro="When the shipping clock is loud, choose a safer category first: useful, cozy, consumable, digital, or easy to pick up. This page routes urgent Christmas shopping into recipient-specific guides and prefilled BrightGift prompts."
	updatedAt="2026-07-03"
	keywords={['last-minute Christmas gifts', 'last minute Christmas gifts', 'last-minute holiday gifts', 'Christmas gift ideas', 'fast shipping gifts', 'Secret Santa gifts']}
	ctaVariant="last_minute_christmas_under_50"
	primaryCtaLabel="Open the Christmas gift finder"
	primaryCtaHref={heroHref}
	footerCtaHref={footerHref}
	experimentId={experimentId}
	generatorPromptTitle="Start with who the gift is for"
	generatorPromptDescription="These prefilled paths keep the gift realistic for the relationship, budget, and delivery risk."
	generatorPrompts={[
		{
			title: 'Girlfriend Christmas gifts',
