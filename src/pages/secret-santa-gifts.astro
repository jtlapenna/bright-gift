---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-secret-santa-202606';

const heroHref = buildGeneratorPrefillHref({
	recipient: 'coworker or Secret Santa recipient',
	interests: 'office gifts, coffee, snacks, desk accessories, cozy winter gifts, useful small gifts',
	budget: 25,
	styles: 'practical,quirky',
	sourceCta: 'secret_santa_hero',
	sourceVariant: 'secret_santa_under_25',
	sourceExperiment: experimentId
});

const funnyHref = buildGeneratorPrefillHref({
	recipient: 'funny coworker',
	interests: 'office humor, coffee, desk setup, snacks, low-pressure gifts',
	budget: 25,
	styles: 'quirky,practical',
	sourceCta: 'secret_santa_prompt',
	sourceVariant: 'funny_coworker_under_25',
	sourceExperiment: experimentId
});

const safeHref = buildGeneratorPrefillHref({
	recipient: 'coworker I do not know well',
	interests: 'coffee, tea, snacks, desk accessories, useful gifts',
	budget: 20,
	styles: 'practical,thoughtful',
	sourceCta: 'secret_santa_prompt',
	sourceVariant: 'safe_coworker_under_20',
	sourceExperiment: experimentId
});

const cozyHref = buildGeneratorPrefillHref({
	recipient: 'friend for Secret Santa',
	interests: 'cozy gifts, winter, self-care, books, tea, candles',
	budget: 30,
	styles: 'cozy,thoughtful',
	sourceCta: 'secret_santa_prompt',
	sourceVariant: 'cozy_secret_santa_under_30',
	sourceExperiment: experimentId
});
const bookLoverHref = buildGeneratorPrefillHref({
	recipient: 'Secret Santa recipient who likes books',
	interests: 'book light, reading journal, bookstore gift card, bookmarks, cozy reading gifts, tea',
	budget: 25,
	styles: 'cozy,thoughtful',
	sourceCta: 'secret_santa_prompt',
	sourceVariant: 'book_lover_secret_santa_under_25',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Gifts under $25',
		description: 'The budget-first page for small gifts, office exchanges, stocking stuffers, and casual recipients.',
		href: '/gifts-under-25/',
		label: 'Budget hub',
		tags: ['under $25', 'budget', 'small gifts']
	},
	{
		title: 'Gifts under $25 for coworkers',
		description: 'A deeper office-specific guide for coworkers, managers, teammates, and work friends.',
		href: '/gifts-for-coworkers-under-25/',
		label: 'Coworkers',
		tags: ['office', 'coworker', 'safe picks']
	},
	{
		title: 'Holiday gift ideas',
		description: 'The broader Q4 hub for Christmas gifts, parent gifts, girlfriend gifts, and last-minute picks.',
		href: '/holiday-gift-ideas/',
		label: 'Holiday hub',
		tags: ['Christmas', 'holiday', 'Q4']
	},
	{
		title: 'Christmas gifts for book lovers',
		description: 'Reader-friendly Secret Santa ideas like book lights, reading journals, bookmarks, and bookstore credits.',
		href: '/christmas-gifts-for-book-lovers/',
		label: 'Book lovers',
		tags: ['books', 'under $25', 'cozy']
	}
];

const sections = [
	{
		title: 'Secret Santa gifts by vibe',
		description: 'Use the relationship and workplace tone to keep the gift fun without making it awkward.',
		links: [
			{
				title: 'Funny Secret Santa gifts',
				description: 'Low-risk humor for a recipient who likes jokes, office bits, coffee, or desk personality.',
				href: funnyHref,
				label: 'Open finder',
				tags: ['funny', 'office', 'under $25']
			},
			{
				title: 'Safe Secret Santa gifts',
				description: 'Useful gifts for someone you barely know: coffee, snacks, desk tools, and practical basics.',
				href: safeHref,
				label: 'Open finder',
				tags: ['safe', 'coworker', 'under $20']
			},
			{
				title: 'Cozy Secret Santa gifts',
				description: 'Winter-friendly ideas like tea, candles, reading extras, soft accessories, and small comforts.',
				href: cozyHref,
				label: 'Open finder',
				tags: ['cozy', 'winter', 'under $30']
			},
			{
				title: 'Book-lover Secret Santa gifts',
				description: 'Small reader gifts that work even when you do not know their exact favorite author.',
				href: bookLoverHref,
				label: 'Open finder',
				tags: ['books', 'reader', 'under $25']
			}
		]
	},
	{
		title: 'Related holiday gift lanes',
		description: 'Use these when the exchange has a clearer recipient, timing problem, or budget rule.',
		links: [
			{
				title: 'Last-minute gift ideas',
				description: 'A better path when the exchange is soon and shipping time matters.',
				href: '/last-minute-gift-ideas/',
				label: 'Fast path',
				tags: ['last minute', 'quick', 'holiday']
			},
			{
				title: 'Christmas gifts for girlfriend',
				description: 'Romantic and thoughtful holiday gift ideas when the recipient is your partner.',
				href: '/christmas-gifts-for-girlfriend/',
				label: 'Girlfriend',
				tags: ['Christmas', 'romantic', 'partner']
			},
			{
				title: 'Gift ideas by budget',
				description: 'Browse budget lanes before choosing a more specific guide or prompt.',
				href: '/gift-ideas-by-budget/',
				label: 'Budget',
				tags: ['under $25', 'under $50', 'under $75']
			},
			{
				title: 'Last-minute Christmas gifts',
				description: 'A stronger path when the exchange is soon and you need digital, pickup, or fast-shipping ideas.',
				href: '/last-minute-christmas-gifts/',
				label: 'Last minute',
				tags: ['fast', 'Christmas', 'shipping']
			}
		]
	}
];

const faqs = [
	{
		question: 'What is a good Secret Santa budget?',
		answer: 'Most workplace Secret Santa exchanges work best around $15 to $25. Stay near the stated limit and choose something useful, consumable, or lightly personal.'
	},
	{
		question: 'What should I avoid for Secret Santa?',
		answer: 'Avoid clothing sizes, strong fragrances, political jokes, alcohol unless you know it is welcome, and anything that feels too intimate for the relationship.'
	}
];
---

<GiftHubPage
	title="Secret Santa Gifts"
	metaTitle="Secret Santa Gifts Under $25 | BrightGift"
	description="Find Secret Santa gifts under $25, including funny, safe, cozy, coworker-friendly, and last-minute gift ideas with prefilled BrightGift AI gift finder paths."
	canonicalPath="/secret-santa-gifts/"
	eyebrow="Secret Santa gift finder"
	heroTitle="Secret Santa gifts that stay useful, fun, and under budget."
	intro="A good Secret Santa gift is low-pressure, easy to enjoy, and not too personal. Start with safe coworker gifts, funny desk-friendly ideas, cozy winter picks, or a prefilled BrightGift prompt when you know the budget but not the person."
	updatedAt="2026-07-02"
	keywords={['Secret Santa gifts', 'Secret Santa gifts under 25', 'coworker Secret Santa gifts', 'funny Secret Santa gifts', 'office gift exchange ideas']}
	ctaVariant="secret_santa_under_25"
	primaryCtaLabel="Open the Secret Santa finder"
	primaryCtaHref={heroHref}
	footerCtaHref={heroHref}
	experimentId={experimentId}
	generatorPromptTitle="Choose the safest Secret Santa lane"
	generatorPromptDescription="These prompts keep the exchange budget-friendly and specific enough to avoid generic gift clutter."
	generatorPrompts={[
		{ title: 'Funny coworker gifts under $25', description: 'Office-safe humor, desk extras, coffee, snacks, and small surprises.', href: funnyHref, ctaVariant: 'funny_coworker_under_25', label: 'Funny' },
		{ title: 'Safe gifts under $20', description: 'Useful, consumable, or practical gifts for someone you do not know well.', href: safeHref, ctaVariant: 'safe_coworker_under_20', label: 'Safe' },
		{ title: 'Cozy gifts under $30', description: 'Winter and comfort ideas for a friendlier exchange.', href: cozyHref, ctaVariant: 'cozy_secret_santa_under_30', label: 'Cozy' },
		{ title: 'Book-lover gifts under $25', description: 'Reading accessories, journals, bookstore credits, and tea pairings.', href: bookLoverHref, ctaVariant: 'book_lover_secret_santa_under_25', label: 'Books' }
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
