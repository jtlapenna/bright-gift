---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
  <title>Care planner</title>
  <link rel="stylesheet" href="/care-calculator/styles.css">
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand"><span class="brand-mark" aria-hidden="true"></span><span>Care planner</span></div>
      <span class="save-status" id="saveStatus" role="status">Saved on this device</span>
    </header>
    <section class="intro" aria-labelledby="pageTitle">
      <div><p class="eyebrow" id="dayType">Daily plan</p><h1 id="pageTitle">Plan the day</h1><p class="intro-copy">Assign time to Jeff or John. School and naps stay outside both targets.</p></div>
      <div class="date-controls" aria-label="Choose day">
        <button type="button" id="previousDay" class="icon-button" aria-label="Previous day">‹</button>
        <label class="date-label"><span class="sr-only">Plan date</span><input id="planDate" type="date"></label>
        <button type="button" id="nextDay" class="icon-button" aria-label="Next day">›</button>
        <button type="button" id="todayButton" class="text-button">Today</button>
      </div>
    </section>
    <p class="notice" id="roomNotice" hidden>Plans now save on this device. If you used an old shared room, <a id="legacyRoomLink" href="/care-calculator/legacy/">download its backup</a>.</p>
    <div class="notice" id="notice" role="status" aria-live="polite" hidden></div>
    <section class="overview" aria-label="Daily totals">
      <div class="open-total"><span class="eyebrow">Time left to assign</span><strong id="openTime">0m</strong><p id="openContext">Across today’s care hours</p><button type="button" id="undoButton" class="undo-button" hidden>Undo last change</button></div>
      <div class="parent-total jeff-total"><div class="parent-heading"><span class="person-dot" aria-hidden="true"></span><h2>Jeff</h2><span id="jeffPercent">0%</span></div><div class="meter" role="progressbar" id="jeffMeter" aria-label="Jeff's planned target" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="jeffBar"></span></div><p><strong id="jeffScheduled">0m</strong> scheduled <span class="stat-divider">·</span> <strong id="jeffRemaining">0m</strong> left</p><p class="overage" id="jeffOver" hidden></p></div>
      <div class="parent-total john-total"><div class="parent-heading"><span class="person-dot" aria-hidden="true"></span><h2>John</h2><span id="johnPercent">0%</span></div><div class="meter" role="progressbar" id="johnMeter" aria-label="John's planned target" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="johnBar"></span></div><p><strong id="johnScheduled">0m</strong> scheduled <span class="stat-divider">·</span> <strong id="johnRemaining">0m</strong> left</p><p class="overage" id="johnOver" hidden></p></div>
    </section>
    <div class="work-area">
      <section class="schedule-section" aria-labelledby="scheduleTitle">
        <div class="section-heading"><div><p class="eyebrow">Your plan</p><h2 id="scheduleTitle">Schedule</h2></div><button type="button" id="addBlock" class="primary-button">Add time</button></div>
        <div class="schedule-list" id="blockList"></div>
        <div class="schedule-footer"><button type="button" id="daySpan" class="day-hours-trigger">Edit day hours</button><button type="button" id="fillOpen" class="quiet-button">Fill open time</button></div>
      </section>
      <aside class="timeline-section" aria-labelledby="timelineTitle">
        <div class="section-heading timeline-heading"><div><p class="eyebrow">At a glance</p><h2 id="timelineTitle">Day timeline</h2></div><div class="zoom-controls" aria-label="Timeline zoom"><button type="button" id="zoomOut" aria-label="Zoom out">−</button><span id="zoomLabel">1×</span><button type="button" id="zoomIn" aria-label="Zoom in">+</button></div></div>
        <p class="timeline-help" id="timelineHelp">Tap open time to add up to one hour for Jeff. Tap a block to reassign it. Hold to move; drag handles to resize. Pinch to zoom.</p><div class="timeline-selection" id="timelineSelection" hidden><p id="timelineSelectionText" role="status"></p><div class="timeline-actions" role="group" aria-label="Assign selected block"><button type="button" data-quick-owner="jeff">Jeff</button><button type="button" data-quick-owner="john">John</button><button type="button" data-quick-owner="free">Free</button><button type="button" id="timelineEdit">Edit details</button></div></div><div class="timeline-viewport" id="timelineViewport"><div class="timeline" id="timeline"></div></div>
      </aside>
    </div>
    <details class="settings" id="settingsPanel">
      <summary>Day settings and backup <span aria-hidden="true">⌄</span></summary>
      <div class="settings-content">
        <form id="settingsForm" novalidate><div class="settings-fields"><label>Wake time <input id="wakeInput" type="time" step="300" required></label><label>Bed time <input id="bedInput" type="time" step="300" required></label><label>John’s target lead <span class="input-suffix"><input id="leadInput" type="number" min="0" max="240" step="1" required><span>min</span></span></label></div><p class="setting-help">Wake and bed times apply to this day and future new days. John’s target lead applies to all days. Odd totals give John the spare minute.</p><p class="form-error" id="settingsError" role="alert" hidden></p><button type="submit" class="secondary-button">Save settings</button><p class="settings-success" id="settingsSuccess" role="status" hidden></p></form>
        <div class="backup-actions"><p>Your plans stay in this browser. Export a backup before clearing browser data or changing devices.</p><div class="button-row"><button type="button" id="exportButton" class="quiet-button">Export backup</button><button type="button" id="importButton" class="quiet-button">Import backup</button><input id="importFile" type="file" accept="application/json,.json" hidden><button type="button" id="resetDay" class="danger-button">Reset this day</button></div><p class="legacy-note" id="legacyNote" hidden>An older plan is included in exported backups.</p><p class="legacy-recovery">Need an old shared room? <a href="/care-calculator/legacy/">Open room recovery</a> to download its plan.</p></div>
      </div>
    </details>
  </main>
  <dialog id="blockDialog" aria-labelledby="dialogTitle">
    <form id="blockForm" novalidate>
      <div class="dialog-heading"><div><p class="eyebrow">Schedule block</p><h2 id="dialogTitle">Add time</h2></div><button type="button" id="closeDialog" class="icon-button" aria-label="Close editor">×</button></div>
      <label>Assign to <select id="blockType" required><option value="jeff">Jeff</option><option value="john">John</option><option value="school">School / free</option><option value="nap">Nap</option><option value="free">Other free time</option></select></label>
      <div class="time-fields"><label>Start <input id="blockStart" type="time" step="300" required></label><label>End <input id="blockEnd" type="time" step="300" required></label></div>
      <p class="form-error" id="blockError" role="alert" hidden></p>
      <div class="dialog-actions"><button type="button" id="deleteBlock" class="danger-button" hidden>Delete block</button><span></span><button type="button" id="cancelBlock" class="quiet-button">Cancel</button><button type="submit" class="primary-button">Save block</button></div>
    </form>
  </dialog>
  <script type="module" src="/care-calculator/app.mjs" is:inline></script>
</body>
</html>
