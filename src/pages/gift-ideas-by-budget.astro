---
import GiftHubPage from '../components/GiftHubPage.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const experimentId = 'bg-generator-search-entry-202606';
const budgetHeroHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'budget gifts, useful gifts, small luxuries, practical surprises',
	budget: 50,
	styles: 'practical,thoughtful',
	sourceCta: 'budget_hub_hero',
	sourceVariant: 'budget_hub_generator',
	sourceExperiment: experimentId
});
const budgetFooterHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'affordable gift ideas, gift occasion, hobbies, daily routine',
	budget: 50,
	styles: 'thoughtful,quirky',
	sourceCta: 'budget_hub_footer',
	sourceVariant: 'budget_hub_generator',
	sourceExperiment: experimentId
});
const under25PromptHref = buildGeneratorPrefillHref({
	recipient: 'coworker or casual friend',
	interests: 'small gifts, office gifts, coffee, desk, useful everyday items',
	budget: 25,
	styles: 'practical,quirky',
	sourceCta: 'budget_hub_prompt',
	sourceVariant: 'budget_under_25',
	sourceExperiment: experimentId
});
const under50PromptHref = buildGeneratorPrefillHref({
	recipient: 'friend or family member',
	interests: 'gift ideas under 50, cozy gifts, tech accessories, books, useful upgrades',
	budget: 50,
	styles: 'thoughtful,practical',
	sourceCta: 'budget_hub_prompt',
	sourceVariant: 'budget_under_50',
	sourceExperiment: experimentId
});
const under75PromptHref = buildGeneratorPrefillHref({
	recipient: 'host or new homeowner',
	interests: 'housewarming, hosting, kitchen, home decor, cozy home',
	budget: 75,
	styles: 'luxury,practical',
	sourceCta: 'budget_hub_prompt',
	sourceVariant: 'budget_under_75',
	sourceExperiment: experimentId
});

const featuredLinks = [
	{
		title: 'Gifts under $25',
		description: 'Budget-friendly gifts for coworkers, Secret Santa, teachers, stocking stuffers, and casual friends.',
		href: '/gifts-under-25/',
		label: 'Under $25',
		tags: ['small gifts', 'office', 'budget']
	},
	{
		title: 'Stocking stuffers under $25',
