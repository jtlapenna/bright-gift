const faqs = [
	{
		question: 'What is a good default gift budget?',
		answer: 'For coworkers and casual friends, $15 to $25 usually feels right. For closer friends and family, $35 to $75 gives you more useful options without requiring a premium purchase.'
	},
	{
		question: 'Should I choose the cheapest gift that matches the person?',
		answer: 'Not always. The best budget gift still needs a job: daily use, comfort, personalization, humor, or problem solving. A cheap gift that adds clutter is rarely the strongest pick.'
	}
];
---

<GiftHubPage
	title="Gift Ideas by Budget"
	metaTitle="Gift Ideas by Budget | BrightGift"
	description="Browse BrightGift gift ideas by budget, including gifts under $25, gifts under $50, housewarming gifts under $75, and budget-friendly AI gift finder pages."
	canonicalPath="/gift-ideas-by-budget/"
	eyebrow="Browse by price"
	heroTitle="Gift ideas by budget that still feel thoughtful."
	intro="A good budget gift should not feel like a compromise. Browse affordable gift ideas under $25, under $50, and under $75, then narrow by recipient or occasion so the final pick feels useful, personal, and comfortably within range."
	updatedAt="2026-07-02"
	keywords={['gift ideas by budget', 'gifts under 25', 'gifts under 50', 'affordable gift ideas', 'budget gift ideas', 'housewarming gifts under 75']}
	ctaVariant="budget_hub_generator"
	primaryCtaLabel="Find gifts in your budget"
	primaryCtaHref={budgetHeroHref}
	footerCtaHref={budgetFooterHref}
	experimentId={experimentId}
	generatorPromptTitle="Choose a budget before you browse"
	generatorPromptDescription="These prefilled gift finder paths keep recommendations inside the price range shoppers actually search for."
	generatorPrompts={[
		{
			title: 'Gifts under $25',
			description: 'Best for coworkers, casual friends, stocking stuffers, and low-pressure gift moments.',
			href: under25PromptHref,
			ctaVariant: 'budget_under_25',
			label: 'Under $25'
		},
		{
			title: 'Gifts under $50',
			description: 'A flexible path for thoughtful gifts that still feel affordable.',
			href: under50PromptHref,
			ctaVariant: 'budget_under_50',
			label: 'Under $50'
		},
		{
			title: 'Housewarming under $75',
			description: 'A higher-intent path for new homeowners, hosts, kitchen gifts, and cozy home upgrades.',
			href: under75PromptHref,
			ctaVariant: 'budget_under_75',
			label: 'Under $75'
		}
	]}
	featuredLinks={featuredLinks}
	sections={sections}
	faqs={faqs}
/>
