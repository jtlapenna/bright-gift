						<h3 class="text-xl font-semibold mb-3 text-[#1C2E4A]">What makes AI gift suggestions better?</h3>
						<p class="text-[#333] font-inter">
							AI gift suggestions are tailored to your needs in real time. Unlike generic lists, our AI considers your recipient's personality, preferences, and occasion, delivering creative and unexpected ideas you might not find elsewhere. This saves you time and helps you discover truly memorable gifts.
						</p>
					</div>
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h3 class="text-xl font-semibold mb-3 text-[#1C2E4A]">Are AI gift generators accurate?</h3>
						<p class="text-[#333] font-inter">
							AI gift generators become more accurate with detailed input. The more specific information you provide about your recipient's interests, lifestyle, and preferences, the better the recommendations will be. They work best when combined with your personal knowledge of the recipient.
						</p>
					</div>
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h3 class="text-xl font-semibold mb-3 text-[#1C2E4A]">How do I get the best results from AI gift generators?</h3>
						<p class="text-[#333] font-inter">
							Provide detailed information about your recipient including their hobbies, lifestyle, recent life changes, and previous gift preferences. Be specific about the occasion and budget. The more context you give, the more personalized and accurate the recommendations will be.
						</p>
					</div>
				</div>
			</div>
		</section>

	</main>

  <!-- Footer removed; provided globally via Layout.astro -->
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.querySelector('form');
		const resultsContainer = document.getElementById('results-container');
		const loadingIndicator = document.getElementById('loading');
			const styleButtons = document.querySelectorAll('button[type="button"]');
			const promptPresetButtons = document.querySelectorAll('[data-generator-preset]');
		const regenerateBtn = document.getElementById('regenerate-btn');
		const emptyState = document.getElementById('empty-state');
			const selectionCount = document.getElementById('selection-count');

			let selectedStyles = [];
			let lastInputs = {};

			function trackBrightGiftEvent(eventName, params = {}) {
				const trackingWindow = window as typeof window & {
					brightGiftTrack?: (eventName: string, params?: Record<string, unknown>) => void;
				};

				if (typeof trackingWindow.brightGiftTrack === 'function') {
					trackingWindow.brightGiftTrack(eventName, params);
				}
			}

			function getAffiliatePlatform(url = '') {
				const href = url.toLowerCase();
				if (href.includes('amazon.com')) return 'amazon';
				if (href.includes('bookshop.org')) return 'bookshop';
				if (href.includes('arjdj2msd.com')) return 'afrofiliate';
				if (href.includes('littleherolabs.com')) return 'direct_partner';
				return 'other';
			}

			function getTrackingUrl(href = '') {
				try {
					return new URL(href, window.location.origin);
				} catch {
					return null;
				}
			}

			function getAsin(url) {
				const match = url.href.match(/\/(?:dp|gp\/product)\/([A-Z0-9]{10})(?:[/?#]|$)/i);
				return match ? match[1].toUpperCase() : '';
			}

			function getAffiliateTrackingId(url, partner) {
				if (partner === 'amazon') return url.searchParams.get('tag') || 'bright-gift-20';
				if (partner === 'bookshop') return url.searchParams.get('affiliate') || 'brightgift';
				if (partner === 'afrofiliate') return url.pathname.split('/').filter(Boolean).slice(0, 3).join('/');
				return url.searchParams.get('tag') || url.searchParams.get('affiliate') || url.searchParams.get('subid') || '';
			}

			function getInternalQaMarker() {
				try {
					const params = new URLSearchParams(window.location.search);
					if (params.get('act_qa') === '1' || params.get('codex_qa') === '1') return 'internal_qa';
					if (window.localStorage?.getItem('affiliate_control_tower_qa') === '1') return 'internal_qa';
				} catch {
					return '';
				}
				return '';
			}

			function getGeneratorResultPayload(link, resultTitle, resultPosition) {
				const url = getTrackingUrl((link as HTMLAnchorElement).href || link.getAttribute('href') || '');
				if (!url) return null;
				const partner = getAffiliatePlatform(url.href);
				if (partner === 'other') return null;

				const internalQaMarker = getInternalQaMarker();
				const productName = (link.getAttribute('data-product-name') || resultTitle || link.textContent || '').trim().slice(0, 120);
				const ctaPosition = link.getAttribute('data-cta-position') || (resultPosition ? `gift_generator_result_${resultPosition}` : 'gift_generator_result');
				const ctaVariant = link.getAttribute('data-cta-variant') || 'generated_result';

				return {
					site: 'brightgift',
					page_url: window.location.pathname,
					page_title: document.title,
					content_type: 'home',
					partner,
					retailer: link.getAttribute('data-retailer') || partner,
					product_id: getAsin(url) || url.searchParams.get('k') || productName.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, ''),
					product_name: productName,
					asin: getAsin(url),
					affiliate_tracking_id: getAffiliateTrackingId(url, partner),
					link_url: url.href,
					link_text: (link.textContent || '').trim().slice(0, 120),
					result_position: resultPosition,
					cta_position: ctaPosition,
					cta_variant: ctaVariant,
					experiment_id: internalQaMarker || link.getAttribute('data-experiment-id') || 'bg-generator-result-click-202606',
					traffic_type: internalQaMarker,
					tracking_version: '2026-06-20',
					event_category: 'Affiliate',
					event_label: `${partner} - ${productName}`
				};
			}

			function getGeneratorTrackingContext(recipient, interests, budget) {
				const interestText = String(interests || '');
				return {
					event_schema_version: '2026-05-13-v2',
					budget: String(budget || ''),
					style_count: selectedStyles.length,
					styles: selectedStyles.join(','),
					recipient_field_length: String(recipient || '').length,
					interest_field_length: interestText.length,
					interest_word_count: interestText.trim() ? interestText.trim().split(/\s+/).length : 0
				};
			}

		// Fun loading messages and tips
		const loadingMessages = [
			"🎯 Finding the perfect gifts...",
			"🧠 Analyzing their interests...",
			"💡 Generating creative ideas...",
			"🎁 Curating amazing options...",
			"✨ Adding that special touch...",
			"🌟 Discovering unique finds...",
			"🎨 Personalizing suggestions...",
			"💝 Making gift-giving magical..."
		];

		const loadingTips = [
			"💡 Did you know? The average person spends 15 hours searching for the perfect gift!",
			"🎯 Pro tip: Consider their hobbies and interests for more meaningful gifts!",
			"✨ Fun fact: Gift-giving releases oxytocin, the 'love hormone'!",
			"🌟 Remember: It's the thought that counts, not the price tag!",
			"🎁 Did you know? Personalized gifts are remembered 3x longer!",
			"💝 Pro tip: Experiences often make better gifts than things!",
			"🎨 Fun fact: The color of gift wrap can influence how the gift is perceived!",
			"✨ Remember: The best gifts solve a problem or fulfill a desire!"
		];

		let loadingInterval;

		// Multi-select style chip functionality
		const styleChips = document.querySelectorAll('.style-chip');

		// Store original colors for each button (original BrightGift brand colors)
		const originalColors = {
			'eco-friendly': { bg: 'bg-[#FFDE59]', text: 'text-[#1C2E4A]', border: 'border-[#FFDE59]', hover: 'hover:bg-[#FFF9F3]' },
			'handmade': { bg: 'bg-[#A3E4DB]', text: 'text-[#1C2E4A]', border: 'border-[#A3E4DB]', hover: 'hover:bg-[#FFF9F3]' },
			'funny': { bg: 'bg-[#FF6B6B]', text: 'text-white', border: 'border-[#FF6B6B]', hover: 'hover:bg-[#ff4c4c]' },
			'pride-gifts': { bg: 'bg-[#FFDE59]', text: 'text-[#1C2E4A]', border: 'border-[#FFDE59]', hover: 'hover:bg-[#FFF9F3]' },
			'quirky': { bg: 'bg-[#A3E4DB]', text: 'text-[#1C2E4A]', border: 'border-[#A3E4DB]', hover: 'hover:bg-[#FFF9F3]' },
			'luxury': { bg: 'bg-[#FF6B6B]', text: 'text-white', border: 'border-[#FF6B6B]', hover: 'hover:bg-[#ff4c4c]' },
			'techy': { bg: 'bg-[#FFDE59]', text: 'text-[#1C2E4A]', border: 'border-[#FFDE59]', hover: 'hover:bg-[#FFF9F3]' },
			'wellness': { bg: 'bg-[#A3E4DB]', text: 'text-[#1C2E4A]', border: 'border-[#A3E4DB]', hover: 'hover:bg-[#FFF9F3]' },
			'athletics': { bg: 'bg-[#FFDE59]', text: 'text-[#1C2E4A]', border: 'border-[#FFDE59]', hover: 'hover:bg-[#FFF9F3]' },
			'beauty': { bg: 'bg-[#FF6B6B]', text: 'text-white', border: 'border-[#FF6B6B]', hover: 'hover:bg-[#ff4c4c]' },
			'black-owned': { bg: 'bg-[#A3E4DB]', text: 'text-[#1C2E4A]', border: 'border-[#A3E4DB]', hover: 'hover:bg-[#FFF9F3]' },
			'book-lover': { bg: 'bg-[#FFDE59]', text: 'text-[#1C2E4A]', border: 'border-[#FFDE59]', hover: 'hover:bg-[#FFF9F3]' }
		};

		styleChips.forEach(button => {
			button.addEventListener('click', () => {
				const style = button.dataset.style;
				const isSelected = button.getAttribute('aria-pressed') === 'true';

				if (isSelected) {
					// Deselect the button
					selectedStyles = selectedStyles.filter(s => s !== style);
					button.setAttribute('aria-pressed', 'false');
				} else {
					// Select the button (if under limit)
					if (selectedStyles.length < 3) {
						selectedStyles.push(style);
						button.setAttribute('aria-pressed', 'true');
					}
				}

				// Update all button states based on selection
				updateAllButtonStates();
				updateSelectionCount();
			});
		});

		function updateAllButtonStates() {
			styleChips.forEach(button => {
				const style = button.dataset.style;
				const isSelected = button.getAttribute('aria-pressed') === 'true';
				const isDisabled = !isSelected && selectedStyles.length >= 3;

				// Reset to base state - all unselected styles become white when any style is selected
				if (selectedStyles.length > 0 && !isSelected) {
					// Unselected styles get white background
					button.className = `style-chip group bg-white text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-gray-200 hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1`;
				} else if (selectedStyles.length === 0) {
					// No styles selected - show truly random pattern (no column grouping)
					if (style === 'eco-friendly' || style === 'quirky' || style === 'techy' || style === 'black-owned') {
						button.className = `style-chip group bg-gradient-to-br from-[#FFDE59] to-[#FFE066] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FFDE59] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1`;
					} else if (style === 'handmade' || style === 'luxury' || style === 'wellness' || style === 'book-lover') {
						button.className = `style-chip group bg-gradient-to-br from-[#A3E4DB] to-[#B8E8E0] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#A3E4DB] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1`;
					} else if (style === 'funny' || style === 'pride-gifts' || style === 'athletics' || style === 'beauty') {
						button.className = `style-chip group bg-gradient-to-br from-[#FF6B6B] to-[#FF8585] text-white px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FF6B6B] hover:from-[#ff4c4c] hover:to-[#ff6666] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1`;
					}
				}

				if (isSelected) {
					// Selected state - make it more prominent with original color
					if (style === 'eco-friendly' || style === 'quirky' || style === 'techy' || style === 'black-owned') {
						button.className = `style-chip group bg-gradient-to-br from-[#FFDE59] to-[#FFE066] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FFDE59] focus:outline-none focus:border-[#FF6B6B] shadow-xl scale-105`;
					} else if (style === 'handmade' || style === 'luxury' || style === 'wellness' || style === 'book-lover') {
						button.className = `style-chip group bg-gradient-to-br from-[#A3E4DB] to-[#B8E8E0] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#A3E4DB] focus:outline-none focus:border-[#FF6B6B] shadow-xl scale-105`;
					} else if (style === 'funny' || style === 'pride-gifts' || style === 'athletics' || style === 'beauty') {
						button.className = `style-chip group bg-gradient-to-br from-[#FF6B6B] to-[#FF8585] text-white px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-xl scale-105`;
					}
				} else if (isDisabled) {
					// Disabled state
					button.classList.add('opacity-50', 'cursor-not-allowed', 'grayscale');
					button.disabled = true;
					button.classList.remove('hover:shadow-lg', 'hover:-translate-y-1', 'transform');
				} else {
					// Enable button if not disabled
					button.disabled = false;
					button.classList.remove('opacity-50', 'cursor-not-allowed', 'grayscale');
				}
			});

			// Update visual preview
			updateStylePreview();
		}

			function updateStylePreview() {
				const displayContainer = document.getElementById('selected-styles-display');

			if (selectedStyles.length > 0) {
				displayContainer.innerHTML = selectedStyles.map(style => {
					const displayName = style.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase());
					return `<span class="px-3 py-1 bg-gradient-to-r from-[#FF6B6B] to-[#FF8585] text-white rounded-full text-xs font-medium shadow-md">${displayName}</span>`;
				}).join('');
			} else {
				displayContainer.innerHTML = `<span class="text-xs text-[#1C2E4A] opacity-50">No styles selected yet</span>`;
				}
			}

			function updateSelectionCount() {
				if (selectionCount) {
					selectionCount.textContent = selectedStyles.length.toString();
				}
			}

			function getPresetStyles(styles) {
				return String(styles || '')
					.split(',')
					.map(style => style.trim())
					.filter(Boolean)
					.slice(0, 3);
			}

			function applyGeneratorPreset(preset) {
				const recipientInput = document.getElementById('recipient');
				const interestsInput = document.getElementById('interests');
				const budgetInput = document.getElementById('budget');
				const presetStyles = getPresetStyles(preset.styles);

				if (recipientInput) recipientInput.value = preset.recipient || '';
				if (interestsInput) interestsInput.value = preset.interests || '';
				if (budgetInput && preset.budget) budgetInput.value = preset.budget;

				selectedStyles = presetStyles;
				styleChips.forEach(styleButton => {
					styleButton.setAttribute('aria-pressed', selectedStyles.includes(styleButton.dataset.style) ? 'true' : 'false');
				});
				updateAllButtonStates();
				updateSelectionCount();
			}

			function scrollToGeneratorForm() {
				document.getElementById('tool')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
				setTimeout(() => {
					const interestsInput = document.getElementById('interests');
					if (interestsInput) interestsInput.focus();
				}, 350);
			}

			function applyPromptPreset(button) {
				const preset = {
					recipient: button.dataset.recipient || '',
					interests: button.dataset.interests || '',
					budget: button.dataset.budget || '',
					styles: button.dataset.styles || ''
				};
				applyGeneratorPreset(preset);

				trackBrightGiftEvent('gift_generator_preset_click', {
					experiment_id: button.dataset.experimentId || '',
					cta_position: button.dataset.ctaPosition || 'homepage_prompt_preset',
					cta_variant: button.dataset.ctaVariant || '',
					recipient: preset.recipient,
					budget: preset.budget,
					styles: selectedStyles.join(','),
					content_type: 'home',
					tracking_version: '2026-06-11'
				});

				scrollToGeneratorForm();
			}

			function applyUrlPrefill() {
				const params = new URLSearchParams(window.location.search);
				const hasPrefill = ['recipient', 'interests', 'budget', 'styles'].some(param => params.has(param));
				if (!hasPrefill) return;

				const preset = {
					recipient: params.get('recipient') || '',
					interests: params.get('interests') || '',
					budget: params.get('budget') || '',
					styles: params.get('styles') || ''
				};
				applyGeneratorPreset(preset);

				trackBrightGiftEvent('gift_generator_prefill', {
					experiment_id: params.get('source_experiment') || 'bg-support-generator-cta-202606',
					cta_position: params.get('source_cta') || 'generator_url_prefill',
					cta_variant: params.get('source_variant') || '',
					recipient: preset.recipient,
					budget: preset.budget,
					styles: selectedStyles.join(','),
					content_type: 'home',
					source: 'url_prefill',
					tracking_version: '2026-06-12'
				});

				if (window.location.hash === '#tool') {
					scrollToGeneratorForm();
				}
			}

			promptPresetButtons.forEach(button => {
				button.addEventListener('click', () => applyPromptPreset(button));
			});

			applyUrlPrefill();

			// Function to cycle through loading messages
		function startLoadingAnimation() {
			const loadingMessage = document.getElementById('loading-message');
			const loadingTip = document.getElementById('loading-tip');
			let messageIndex = 0;
			let tipIndex = 0;

			loadingInterval = setInterval(() => {
				// Cycle through messages every 2 seconds
				loadingMessage.textContent = loadingMessages[messageIndex];
				messageIndex = (messageIndex + 1) % loadingMessages.length;

				// Cycle through tips every 4 seconds
				if (messageIndex % 2 === 0) {
					loadingTip.textContent = loadingTips[tipIndex];
					tipIndex = (tipIndex + 1) % loadingTips.length;
				}
			}, 2000);
		}

		function stopLoadingAnimation() {
			if (loadingInterval) {
				clearInterval(loadingInterval);
				loadingInterval = null;
			}
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			// Scroll to results section immediately
			document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
			const formData = new FormData(form);
			const recipient = formData.get('recipient');
			const interests = formData.get('interests');
			const budget = formData.get('budget');
				if (!recipient || !interests || !budget) {
					resultsContainer.innerHTML = `<p class="text-red-500 text-center" role="alert">Please fill in all required fields.</p>`;
					return;
				}
				trackBrightGiftEvent('gift_generator_start', getGeneratorTrackingContext(recipient, interests, budget));
				loadingIndicator.classList.remove('hidden');
				resultsContainer.innerHTML = '';
				startLoadingAnimation();

			try {
				const response = await fetch('/api/generate', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ recipient, interests, budget, styles: selectedStyles }),
				});
				let errorMsg = 'Failed to get ideas.';
				if (!response.ok) {
					try {
						const err = await response.json();
						errorMsg = err.error || errorMsg;
					} catch {}
					throw new Error(errorMsg);
				}
					const { ideas } = await response.json();
					if (Array.isArray(ideas) && ideas.length) {
					resultsContainer.innerHTML = renderIdeaCards(ideas);
					regenerateBtn.classList.remove('hidden');
					regenerateBtn.style.display = '';
					trackBrightGiftEvent('gift_generator_results_shown', {
						...getGeneratorTrackingContext(recipient, interests, budget),
						result_count: ideas.length
					});
					// Show share section and update shareable content
					showShareSection(ideas, recipient, interests, budget);
				} else {
					resultsContainer.innerHTML = `<p class="text-red-500 text-center" role="alert">No gift ideas found or failed to parse results. Please try again.</p>`;
					regenerateBtn.classList.add('hidden');
					regenerateBtn.style.display = 'none';
					trackBrightGiftEvent('gift_generator_no_results', getGeneratorTrackingContext(recipient, interests, budget));
					hideShareSection();
				}
				lastInputs = { recipient, interests, budget, styles: selectedStyles };
				} catch (error) {
					const errorMessage = error.message || "We're having trouble generating gift ideas right now. Please try again in a moment.";
					trackBrightGiftEvent('gift_generator_error', {
						...getGeneratorTrackingContext(recipient, interests, budget),
						error_message: errorMessage.slice(0, 120)
					});
					resultsContainer.innerHTML = `
					<div class="text-center" role="alert">
						<div class="bg-red-50 border border-red-200 rounded-lg p-6 max-w-md mx-auto">
							<div class="flex items-center justify-center mb-3">
								<svg class="w-6 h-6 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
								</svg>
								<span class="text-red-800 font-semibold">Oops! Something went wrong</span>
							</div>
							<p class="text-red-700 text-sm">${errorMessage}</p>
							<button onclick="location.reload()" class="mt-4 bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-semibold py-2 px-4 rounded-full transition-colors text-sm">
								Try Again
							</button>
						</div>
					</div>`;
				regenerateBtn.classList.add('hidden');
				regenerateBtn.style.display = 'none';
			} finally {
				stopLoadingAnimation();
				loadingIndicator.classList.add('hidden');
			}
		});

			regenerateBtn.addEventListener('click', async () => {
				if (!lastInputs.recipient) return;
				// Scroll to results section before clearing results
				document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
				trackBrightGiftEvent('gift_generator_start', {
					...getGeneratorTrackingContext(lastInputs.recipient, lastInputs.interests, lastInputs.budget),
					is_regeneration: true
				});
				loadingIndicator.classList.remove('hidden');
				resultsContainer.innerHTML = '';
				startLoadingAnimation();
			try {
				const response = await fetch('/api/generate', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(lastInputs),
				});
					if (!response.ok) throw new Error('Failed to get ideas.');
					const { ideas } = await response.json();
					resultsContainer.innerHTML = renderIdeaCards(ideas);
					regenerateBtn.classList.add('hidden');
					regenerateBtn.style.display = 'none';
					trackBrightGiftEvent('gift_generator_results_shown', {
						...getGeneratorTrackingContext(lastInputs.recipient, lastInputs.interests, lastInputs.budget),
						is_regeneration: true,
						result_count: Array.isArray(ideas) ? ideas.length : 0
					});
				} catch (error) {
					const errorMessage = error.message || "We're having trouble generating gift ideas right now. Please try again in a moment.";
					trackBrightGiftEvent('gift_generator_error', {
						...getGeneratorTrackingContext(lastInputs.recipient, lastInputs.interests, lastInputs.budget),
						is_regeneration: true,
						error_message: errorMessage.slice(0, 120)
					});
					resultsContainer.innerHTML = `
					<div class="text-center" role="alert">
						<div class="bg-red-50 border border-red-200 rounded-lg p-6 max-w-md mx-auto">
							<div class="flex items-center justify-center mb-3">
								<svg class="w-6 h-6 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
								</svg>
								<span class="text-red-800 font-semibold">Oops! Something went wrong</span>
							</div>
							<p class="text-red-700 text-sm">${errorMessage}</p>
							<button onclick="location.reload()" class="mt-4 bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-semibold py-2 px-4 rounded-full transition-colors text-sm">
								Try Again
							</button>
						</div>
					</div>`;
				regenerateBtn.classList.add('hidden');
				regenerateBtn.style.display = 'none';
			} finally {
				loadingIndicator.classList.add('hidden');
			}
		});

				resultsContainer.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;

				const link = target.closest('a[href]');
				if (!link || !resultsContainer.contains(link)) return;

				const href = link.getAttribute('href') || '';
				const resultCard = link.closest('[role="listitem"]');
				const resultTitle = resultCard?.querySelector('h3')?.textContent?.trim() || '';
				const resultPosition = resultCard?.getAttribute('data-result-position') || '';
				const standardPayload = getGeneratorResultPayload(link, resultTitle, resultPosition);

				trackBrightGiftEvent('gift_generator_result_click', {
					affiliate_platform: getAffiliatePlatform(href),
					partner: getAffiliatePlatform(href),
					link_url: (link as HTMLAnchorElement).href,
					link_text: (link.textContent || '').trim().slice(0, 120),
					result_title: resultTitle.slice(0, 120),
					product_name: resultTitle.slice(0, 120),
					result_position: resultPosition,
					cta_position: link.getAttribute('data-cta-position') || (resultPosition ? `gift_generator_result_${resultPosition}` : 'gift_generator_result')
				});

				if (standardPayload) {
					trackBrightGiftEvent('affiliate_click', standardPayload);
					if (standardPayload.partner === 'amazon') {
						trackBrightGiftEvent('amazon_click', standardPayload);
					}
				}
			});

			// Share functionality
		function showShareSection(ideas, recipient, interests, budget) {
			const shareSection = document.getElementById('share-section');
			const shareableTextPreview = document.getElementById('shareable-text-preview');

			if (shareSection && shareableTextPreview) {
				shareSection.classList.remove('hidden');

				// Generate shareable text
				const shareableText = generateShareableText(ideas, recipient, interests, budget);
				shareableTextPreview.textContent = shareableText;

				// Store in data attribute for easy access
				shareSection.dataset.shareableText = shareableText;
			}
		}

		function hideShareSection() {
			const shareSection = document.getElementById('share-section');
			if (shareSection) {
				shareSection.classList.add('hidden');
			}
		}

		function generateShareableText(ideas, recipient, interests, budget) {
			let text = `🎁 Gift Ideas for ${recipient}\n\n`;
			text += `Looking for: ${interests}\n`;
			text += `Budget: Under $${budget}\n\n`;
			text += `Here are some great gift ideas:\n\n`;

			ideas.slice(0, 5).forEach((idea, index) => {
				text += `${index + 1}. ${idea.title}\n`;
				if (idea.description) {
					text += `   ${idea.description.substring(0, 100)}${idea.description.length > 100 ? '...' : ''}\n`;
				}
				text += `\n`;
			});

			text += `\nFound these using Bright Gift - AI Gift Finder\n`;
			text += `https://bright-gift.com/\n`;

			return text;
		}

		// Share button handlers
		const copyLinkBtn = document.getElementById('copy-link-btn');
		const copyTextBtn = document.getElementById('copy-text-btn');
		const shareNativeBtn = document.getElementById('share-native-btn');
		const copyConfirmation = document.getElementById('copy-confirmation');

		if (copyLinkBtn) {
			copyLinkBtn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(window.location.href);
					showCopyConfirmation();
				} catch (err) {
					console.error('Failed to copy link:', err);
				}
			});
		}

		if (copyTextBtn) {
			copyTextBtn.addEventListener('click', async () => {
				const shareSection = document.getElementById('share-section');
				const shareableText = shareSection?.dataset.shareableText;

				if (shareableText) {
					try {
						await navigator.clipboard.writeText(shareableText);
						showCopyConfirmation();
					} catch (err) {
						console.error('Failed to copy text:', err);
					}
				}
			});
		}

		if (shareNativeBtn) {
			shareNativeBtn.addEventListener('click', async () => {
				const shareSection = document.getElementById('share-section');
				const shareableText = shareSection?.dataset.shareableText;

				if (navigator.share && shareableText) {
					try {
						await navigator.share({
							title: 'Gift Ideas from Bright Gift',
							text: shareableText,
							url: window.location.href
						});
					} catch (err) {
						// User cancelled or share failed
						if (window.location.search.includes('debug_share=1')) {
							console.log('Share cancelled or failed:', err);
						}
					}
				} else {
					// Fallback to copy
					if (shareableText) {
						try {
							await navigator.clipboard.writeText(shareableText);
							showCopyConfirmation();
						} catch (err) {
							console.error('Failed to copy text:', err);
						}
					}
				}
			});
		}

		function showCopyConfirmation() {
			if (copyConfirmation) {
				copyConfirmation.classList.remove('hidden');
				setTimeout(() => {
					copyConfirmation.classList.add('hidden');
				}, 3000);
			}
		}
	});

	// Function to get brand name from Afrofiliate or direct partner link
	function getBrandName(link) {
		if (!link) return 'Brand';
		if (/littleherolabs\.com/i.test(link)) return 'Little Hero Labs';
		if (!link.includes('arjdj2msd.com')) {
			return 'Brand';
		}

		const brandMap = {
			'QWRG9C': 'BeautyStat',
			'R2Z4H6': 'Furi Sport',
			'R74QP1': 'Be Rooted',
			'RC9DWS': 'Kadalys',
			'24BMB4P': 'Be Yourself 314',
			'24D26TB': 'Endorf',
			'24R58Q6': 'Caribe Coffee',
			'2CTPL1': 'Cashblack UK',
			'M823SF': 'Cashblack US'
		};

		for (const [code, name] of Object.entries(brandMap)) {
			if (link.includes(code)) {
				return name;
			}
		}

		return 'Brand';
	}

	function renderIdeaCards(ideas) {
		const iconSvgMap = {
			DeviceMobile: '/icons/DeviceMobile.svg',
			Book: '/icons/Book.svg',
			TShirt: '/icons/TShirt.svg',
			House: '/icons/House.svg',
			Tree: '/icons/Tree.svg',
			CookingPot: '/icons/CookingPot.svg',
			PuzzlePiece: '/icons/PuzzlePiece.svg',
			Flower: '/icons/Flower.svg',
			SoccerBall: '/icons/SoccerBall.svg',
			PawPrint: '/icons/PawPrint.svg',
			Baby: '/icons/Baby.svg',
			Car: '/icons/Car.svg',
			Briefcase: '/icons/Briefcase.svg',
			MusicNote: '/icons/MusicNote.svg',
			Heartbeat: '/icons/Heartbeat.svg',
			ShoppingBag: '/icons/ShoppingBag.svg',
			BeerBottle: '/icons/BeerBottle.svg',
			Pencil: '/icons/Pencil.svg',
			Package: '/icons/Package.svg',
			Wrench: '/icons/Wrench.svg',
			Smiley: '/icons/Smiley.svg',
			Diamond: '/icons/Diamond.svg',
			PaintBrush: '/icons/PaintBrush.svg',
			Sparkle: '/icons/Sparkle.svg',
			Backpack: '/icons/Backpack.svg',
			Shield: '/icons/Shield.svg',
			Scissors: '/icons/Scissors.svg',
			Palette: '/icons/Palette.svg',
			FilmSlate: '/icons/FilmSlate.svg',
			Lamp: '/icons/Lamp.svg',
			Note: '/icons/Note.svg',
			Ticket: '/icons/Ticket.svg',
			FrameCorners: '/icons/FrameCorners.svg',
			Gift: '/icons/Gift.svg'
		};

		// Function to get descriptive alt text for icons
		function getIconDescription(iconName) {
			const descriptions = {
				DeviceMobile: 'Mobile device icon for tech gifts',
				Book: 'Book icon for reading and literature gifts',
				TShirt: 'Clothing icon for fashion and apparel gifts',
				House: 'Home icon for housewarming and home decor gifts',
				Tree: 'Nature icon for eco-friendly and outdoor gifts',
				CookingPot: 'Kitchen icon for cooking and culinary gifts',
				PuzzlePiece: 'Puzzle icon for games and entertainment gifts',
				Flower: 'Flower icon for gardening and nature gifts',
				SoccerBall: 'Sports icon for athletic and fitness gifts',
				PawPrint: 'Pet icon for animal lover gifts',
				Baby: 'Baby icon for baby shower and parenting gifts',
				Car: 'Vehicle icon for automotive and travel gifts',
				Briefcase: 'Business icon for professional and work gifts',
				MusicNote: 'Music icon for audio and entertainment gifts',
				Heartbeat: 'Health icon for wellness and self-care gifts',
				ShoppingBag: 'Shopping icon for retail and lifestyle gifts',
				BeerBottle: 'Beverage icon for food and drink gifts',
				Pencil: 'Writing icon for stationery and creative gifts',
				Package: 'Package icon for delivery and surprise gifts',
				Wrench: 'Tool icon for DIY and hobby gifts',
				Smiley: 'Emoji icon for fun and entertainment gifts',
				Diamond: 'Luxury icon for premium and high-end gifts',
				PaintBrush: 'Art icon for creative and artistic gifts',
				Sparkle: 'Sparkle icon for special and unique gifts',
				Backpack: 'Travel icon for adventure and outdoor gifts',
				Shield: 'Security icon for protective and safety gifts',
				Scissors: 'Craft icon for handmade and DIY gifts',
				Palette: 'Art icon for creative and design gifts',
				FilmSlate: 'Entertainment icon for movie and media gifts',
				Lamp: 'Lighting icon for home decor and ambiance gifts',
				Note: 'Writing icon for journal and stationery gifts',
				Ticket: 'Event icon for experience and entertainment gifts',
				FrameCorners: 'Photo icon for photography and memory gifts',
				Gift: 'Gift box icon for general gift recommendations'
			};
			return descriptions[iconName] || 'Gift recommendation icon';
		}

		function escapeAttr(value) {
			return String(value || '')
				.replace(/&/g, '&amp;')
				.replace(/"/g, '&quot;')
				.replace(/</g, '&lt;');
		}

		function getIdeaPartner(idea) {
			const link = String(idea.link || '').toLowerCase();
			if (idea.affiliateType === 'direct' || link.includes('littleherolabs.com')) return 'little_hero_labs';
			if (idea.affiliateType === 'afrofiliate' || link.includes('arjdj2msd.com')) return 'afrofiliate';
			if (idea.affiliateType === 'bookshop' || link.includes('bookshop.org')) return 'bookshop';
			if (idea.affiliateType === 'amazon' || link.includes('amazon.')) return 'amazon';
			return idea.affiliateType || 'other';
		}

		// Group ideas by title to handle hybrid cards
		const groupedIdeas = [];
		const processedTitles = new Set();

		// First pass: group by title and affiliate type
		ideas.forEach(idea => {
			const baseTitle = idea.title;

			if (processedTitles.has(baseTitle)) {
				// Find the existing group and add this as the alternative
				const existingGroup = groupedIdeas.find(group => group.baseTitle === baseTitle);
				if (existingGroup && !existingGroup.alternative) {
					existingGroup.alternative = idea;
				}
			} else {
				// Create new group
				processedTitles.add(baseTitle);
				groupedIdeas.push({
					baseTitle,
					primary: idea,
					alternative: null
				});
			}
		});

		// Filter out groups that don't have both Afrofiliate and Amazon options
		// A true hybrid card requires:
		// 1. Must have both primary and alternative
		// 2. One must be afrofiliate and the other must be amazon
		const hybridGroups = groupedIdeas.filter(group => {
			// Must have both primary and alternative
			if (!group.alternative) {
				return false;
			}

			// Check if one is afrofiliate and the other is amazon
			const primaryIsAfrofiliate = group.primary.affiliateType === 'afrofiliate' || /arjdj2msd\.com/i.test(group.primary.link);
			const primaryIsAmazon = group.primary.affiliateType === 'amazon' || /amazon\.com/i.test(group.primary.link);

			const altIsAfrofiliate = group.alternative.affiliateType === 'afrofiliate' || /arjdj2msd\.com/i.test(group.alternative.link);
			const altIsAmazon = group.alternative.affiliateType === 'amazon' || /amazon\.com/i.test(group.alternative.link);

			// True hybrid: one afrofiliate, one amazon (in any order)
			return (primaryIsAfrofiliate && altIsAmazon) || (primaryIsAmazon && altIsAfrofiliate);
		});

		// Render hybrid groups first, then regular ideas
		const hybridCards = hybridGroups.map((group, index) => {
			const idea = group.primary;
			const resultPosition = index + 1;
			const resultTitle = escapeAttr(idea.title);
			let iconHtml = '';
			if (idea.icon) {
				const iconPath = iconSvgMap[idea.icon] || iconSvgMap['ShoppingBag'];
				const iconDescription = getIconDescription(idea.icon);
				iconHtml = `<img src="${iconPath}" alt="${iconDescription}" class="h-20 w-20 mb-6 mt-2" loading="lazy" />`;
			}

			// Check if this is a hybrid card (has both Afrofiliate and Amazon options)
			const isHybrid = group.alternative &&
				((idea.affiliateType === 'afrofiliate' && group.alternative.affiliateType === 'amazon') ||
				 (idea.affiliateType === 'amazon' && group.alternative.affiliateType === 'afrofiliate'));

			let buttonHtml = '';
			if (isHybrid) {
				// Hybrid card with two buttons
				const afrofiliateIdea = idea.affiliateType === 'afrofiliate' ? idea : group.alternative;
				const amazonIdea = idea.affiliateType === 'amazon' ? idea : group.alternative;

				buttonHtml = `
					<div class="w-full space-y-3">
						<a href="${afrofiliateIdea.link}" target="_blank" rel="sponsored nofollow noopener noreferrer"
						   data-cta-position="gift_generator_result_${resultPosition}_afrofiliate"
						   data-cta-variant="generated_result_hybrid_afrofiliate"
						   data-product-name="${resultTitle}"
						   data-retailer="afrofiliate"
						   class="w-full bg-white hover:bg-gray-50 text-[#1C2E4A] font-bold py-3 px-6 rounded-full transition-colors font-poppins text-sm shadow text-center border-2 border-[#1C2E4A] hover:border-[#FF6B6B] flex items-center justify-center gap-2 whitespace-nowrap"
						   aria-label="Shop ${idea.title} from Black-owned brand">
							<span>🌟</span>
							<span>Shop ${getBrandName(afrofiliateIdea.link)}</span>
						</a>
						<a href="${amazonIdea.link}" target="_blank" rel="sponsored nofollow noopener noreferrer"
						   data-cta-position="gift_generator_result_${resultPosition}_amazon"
						   data-cta-variant="generated_result_hybrid_amazon"
						   data-product-name="${resultTitle}"
						   data-retailer="amazon"
						   class="w-full bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-bold py-3 px-6 rounded-full transition-colors font-poppins text-sm shadow text-center flex items-center justify-center gap-2 whitespace-nowrap"
						   aria-label="Find similar products on Amazon">
							<span>🛒</span>
							<span>Find Similar on Amazon</span>
						</a>
					</div>
				`;
			} else {
							// Single button for regular cards
			let buttonText = 'Find on Amazon';
			if (idea.affiliateType === 'afrofiliate') {
				buttonText = `🌟 Shop ${getBrandName(idea.link)}`;
			} else if (/bookshop/i.test(idea.link)) {
				buttonText = '📖 Find on Bookshop.org';
			} else if (idea.affiliateType === 'direct' || /littleherolabs\.com/i.test(idea.link)) {
				buttonText = 'Create at Little Hero Labs';
			} else if (/arjdj2msd\.com/i.test(idea.link)) {
				buttonText = `🌟 Shop ${getBrandName(idea.link)}`;
			}
				const outlineStyle = idea.affiliateType === 'afrofiliate' || /arjdj2msd\.com/i.test(idea.link) || idea.affiliateType === 'direct' || /littleherolabs\.com/i.test(idea.link);
				const linkLabel = idea.affiliateType === 'direct' || /littleherolabs\.com/i.test(idea.link) ? 'link' : 'affiliate link';
				buttonHtml = `
					<a href="${idea.link}" target="_blank" rel="sponsored nofollow noopener noreferrer"
					   data-cta-position="gift_generator_result_${resultPosition}_${getIdeaPartner(idea)}"
					   data-cta-variant="generated_result_single"
					   data-product-name="${resultTitle}"
					   data-retailer="${getIdeaPartner(idea)}"
					   class="w-full ${outlineStyle ? 'bg-white hover:bg-gray-50 text-[#1C2E4A] border-2 border-[#1C2E4A] hover:border-[#FF6B6B]' : 'bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white'} font-bold py-3 rounded-full transition-colors font-poppins text-lg shadow text-center"
					   aria-label="View ${idea.title} (${linkLabel})">
						${buttonText}
					</a>
				`;
			}

			return `
				<div class="flex flex-col items-center justify-between bg-[#A3E4DB] rounded-2xl shadow-lg p-6 min-h-[480px] transition-transform hover:-translate-y-1 hover:shadow-2xl animate-fade-in" role="listitem" data-result-position="${resultPosition}" data-product-name="${resultTitle}">
					${iconHtml || (idea.image ? `<img src="${idea.image}" alt="${idea.title} - Gift recommendation" class="h-40 w-full object-cover mb-4 rounded-xl shadow" loading="lazy">` : '')}
					<h3 class="font-bold text-xl mb-2 font-poppins text-[#1C2E4A] text-center">${idea.title}</h3>
					<p class="text-[#333] mb-3 font-inter text-sm text-center line-clamp-8 flex-grow">${idea.description}</p>
					${idea.tag ? `<span class="inline-block bg-[#FFDE59] text-[#1C2E4A] text-xs font-semibold px-3 py-1 rounded-full mb-4 whitespace-nowrap">${idea.tag}</span>` : ''}
					${buttonHtml}
				</div>
			`;
		});

		// Render regular ideas (non-hybrid)
		const regularIdeas = ideas.filter(idea => {
			const isInHybridGroup = hybridGroups.some(group =>
				group.baseTitle === idea.title
			);
			return !isInHybridGroup;
		});

		const regularCards = regularIdeas.map((idea, index) => {
			const resultPosition = hybridGroups.length + index + 1;
			const resultTitle = escapeAttr(idea.title);
			let iconHtml = '';
			if (idea.icon) {
				const iconPath = iconSvgMap[idea.icon] || iconSvgMap['ShoppingBag'];
				const iconDescription = getIconDescription(idea.icon);
				iconHtml = `<img src="${iconPath}" alt="${iconDescription}" class="h-20 w-20 mb-6 mt-2" loading="lazy" />`;
			}

			// Single button for regular cards
			let buttonText = 'Find on Amazon';
			if (idea.affiliateType === 'afrofiliate') {
				buttonText = `🌟 Shop ${getBrandName(idea.link)}`;
			} else if (/bookshop/i.test(idea.link)) {
				buttonText = '📖 Find on Bookshop.org';
			} else if (idea.affiliateType === 'direct' || /littleherolabs\.com/i.test(idea.link)) {
				buttonText = 'Create at Little Hero Labs';
			} else if (/arjdj2msd\.com/i.test(idea.link)) {
				buttonText = `🌟 Shop ${getBrandName(idea.link)}`;
			}
			const outlineStyle = idea.affiliateType === 'afrofiliate' || /arjdj2msd\.com/i.test(idea.link) || idea.affiliateType === 'direct' || /littleherolabs\.com/i.test(idea.link);
			const linkLabel = idea.affiliateType === 'direct' || /littleherolabs\.com/i.test(idea.link) ? 'link' : 'affiliate link';
			const buttonHtml = `
				<a href="${idea.link}" target="_blank" rel="sponsored nofollow noopener noreferrer"
				   data-cta-position="gift_generator_result_${resultPosition}_${getIdeaPartner(idea)}"
				   data-cta-variant="generated_result_single"
				   data-product-name="${resultTitle}"
				   data-retailer="${getIdeaPartner(idea)}"
				   class="w-full ${outlineStyle ? 'bg-white hover:bg-gray-50 text-[#1C2E4A] border-2 border-[#1C2E4A] hover:border-[#FF6B6B]' : 'bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white'} font-bold py-3 rounded-full transition-colors font-poppins text-lg shadow text-center"
				   aria-label="View ${idea.title} (${linkLabel})">
					${buttonText}
				</a>
			`;

			return `
				<div class="flex flex-col items-center justify-between bg-[#A3E4DB] rounded-2xl shadow-lg p-6 min-h-[480px] transition-transform hover:-translate-y-1 hover:shadow-2xl animate-fade-in" role="listitem" data-result-position="${resultPosition}" data-product-name="${resultTitle}">
					${iconHtml || (idea.image ? `<img src="${idea.image}" alt="${idea.title} - Gift recommendation" class="h-40 w-full object-cover mb-4 rounded-xl shadow" loading="lazy">` : '')}
					<h3 class="font-bold text-xl mb-2 font-poppins text-[#1C2E4A] text-center">${idea.title}</h3>
					<p class="text-[#333] mb-3 font-inter text-sm text-center line-clamp-8 flex-grow">${idea.description}</p>
					${idea.tag ? `<span class="inline-block bg-[#FFDE59] text-[#1C2E4A] text-xs font-semibold px-3 py-1 rounded-full mb-4 whitespace-nowrap">${idea.tag}</span>` : ''}
					${buttonHtml}
				</div>
			`;
		});

		return [...hybridCards, ...regularCards].join('');
	}

	const style = document.createElement('style');
	style.innerHTML = `
		@keyframes fadeIn {
			from { opacity: 0; transform: translateY(10px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.animate-fade-in {
			animation: fadeIn 0.5s ease-out forwards;
		}

		/* Style chip animations and states */
		.style-chip {
			transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		}

		.style-chip:hover:not(.cursor-not-allowed) {
			transform: translateY(-1px);
		}

		.style-chip:active {
			transform: translateY(0);
		}

		/* Selected state with subtle glow */
		.style-chip[aria-pressed="true"] {
			box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
		}

		/* Disabled state */
		.style-chip.cursor-not-allowed {
			pointer-events: none;
		}
	`;
	document.head.appendChild(style);
</script>
