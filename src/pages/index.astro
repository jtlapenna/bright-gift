---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
// Hero images for responsive loading
const heroImageMobile = '/hero-image-mobile.webp';
const heroImageDesktop = '/hero-image-desktop.webp';
// Phosphor Icons for Amazon placeholders
import { DeviceMobile, Book, TShirt, House, Tree, CookingPot, PuzzlePiece, SoccerBall, PawPrint, Baby, Car, Briefcase, MusicNote, Heartbeat, ShoppingBag } from 'phosphor-icons';

// Load blog posts and gift guides, including drafts only in preview
const isPreview = import.meta.env.IS_PREVIEW === 'true';
const blogPosts = await getCollection('blog', ({ data }) => isPreview || (!data.draft && data.sitemap !== false));
// Combine and sort all content by date
const allContent = blogPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const experimentId = 'bg-home-generator-sprint-202606';

// Meta description for homepage
const metaDescription = "Use BrightGift's free AI gift idea generator to find gift ideas by recipient, budget, interest, and occasion. Get personalized suggestions in under a minute.";

// Define structured data for the homepage
const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "BrightGift - AI Gift Idea Generator",
	"url": "https://bright-gift.com/",
		"description": metaDescription,
	"potentialAction": {
		"@type": "SearchAction",
		"target": "https://bright-gift.com/#tool?recipient={recipient}&interests={interests}",
		"query-input": [
			"required name=recipient",
			"required name=interests"
		]
	}
};

// Organization schema
const organizationData = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "BrightGift",
	"url": "https://bright-gift.com/",
	"logo": {
		"@type": "ImageObject",
		"url": "https://bright-gift.com/bright-gift-logo.png",
		"width": 512,
		"height": 512
	},
	"sameAs": [
		"https://x.com/Bright_Gift_AI",
		"https://www.facebook.com/profile.php?id=61578326463381",
		"https://www.instagram.com/bright_gift_ai/",
		"https://www.pinterest.com/0nd1k1wpo6tpeq69x0kebf7izyhu1i/",
		"https://bsky.app/profile/brightgift.bsky.social"
	],
	"contactPoint": {
		"@type": "ContactPoint",
		"contactType": "customer service",
		"url": "https://bright-gift.com/contact/"
	}
};

// Breadcrumb schema
const breadcrumbData = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": "https://bright-gift.com/"
		}
	]
};

// FAQPage schema
const faqData = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "How does the AI Gift Idea Generator work?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Our AI Gift Idea Generator uses advanced artificial intelligence to analyze your recipient's interests, style, and budget. It then suggests unique, thoughtful gifts by matching your input to a curated database of products and ideas, ensuring every recommendation is relevant and personalized."
			}
		},
		{
			"@type": "Question",
			"name": "What makes AI gift suggestions better?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "AI gift suggestions are tailored to your needs in real time. Unlike generic lists, our AI considers your recipient's personality, preferences, and occasion, delivering creative and unexpected ideas you might not find elsewhere. This saves you time and helps you discover truly memorable gifts."
			}
		},
		{
			"@type": "Question",
			"name": "Are AI gift generators accurate?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "AI gift generators become more accurate with detailed input. The more specific information you provide about your recipient's interests, lifestyle, and preferences, the better the recommendations will be. They work best when combined with your personal knowledge of the recipient."
			}
		},
		{
			"@type": "Question",
			"name": "How do I get the best results from AI gift generators?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Provide detailed information about your recipient including their hobbies, lifestyle, recent life changes, and previous gift preferences. Be specific about the occasion and budget. The more context you give, the more personalized and accurate the recommendations will be."
			}
		}
	]
};
---

<Layout
	title="Free AI Gift Idea Generator by Recipient, Budget & Occasion"
	description={metaDescription}
	image="/images/homepage-banner.webp"
	keywords={["AI gift idea generator", "free AI gift generator", "gift ideas by budget", "gift finder by recipient", "personalized gift recommendations", "gift ideas for girlfriend", "coworker gifts under 25", "housewarming gifts under 75", "remote worker gifts", "last minute gift ideas", "birthday gift ideas", "holiday gifts", "unique gift ideas", "thoughtful gifts", "gift guide"]}
	canonical="https://bright-gift.com/"
	ogType="website"
	twitterCard="summary_large_image"
>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<script type="application/ld+json" set:html={JSON.stringify(organizationData)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqData)} />

	<main class="font-sans text-gray-800 dark:text-gray-200">
		<!-- Hero Section (responsive, overlapping image on desktop) -->
		<section class="relative w-full bg-[#FEF2D3] shadow-lg border-t-8 border-[#FF6B6B] mt-0 mx-auto px-0 py-0 md:py-6 flex flex-col items-center justify-center h-[345px] md:min-h-[350px]">
			<div class="flex flex-col md:flex-row items-center justify-center w-full max-w-4xl gap-4 md:gap-8 px-2 md:px-6">
				<div class="flex-1 flex flex-col items-center md:items-start justify-center text-center md:text-left mt-36 md:mt-0">
					<img src="/bright-gift-logo.png" alt="BrightGift logo - AI gift idea generator" class="h-12 md:h-24 mb-1 md:mb-4" />
						<h1 class="text-xl md:text-4xl font-bold font-poppins text-[#1C2E4A] mb-1 md:mb-2 md:whitespace-nowrap">Free AI Gift Idea Generator</h1>
						<p class="text-sm md:text-lg font-inter text-[#333] mb-1 md:mb-4">Find gift ideas by recipient, budget, interest, and occasion in under a minute.</p>
				</div>
				<div class="flex-1 flex items-center justify-center relative mt-30 md:mt-0">
					<picture>
	<source srcset={heroImageMobile} media="(max-width: 768px)" />
	<source srcset={heroImageDesktop} media="(min-width: 769px)" />
	<img src={heroImageDesktop} alt="AI-powered gift suggestions interface" class="max-h-[154px] md:max-h-[412px] w-auto md:absolute md:left-1/2 md:-translate-x-1/2 z-10" style="bottom:-240px;" fetchpriority="high" />
</picture>
				</div>
			</div>
		</section>

		<!-- Tool Section -->
		<section id="tool" class="px-4 pt-10 pb-16 md:pt-12 md:pb-20">
			<div class="max-w-7xl mx-auto">
				<!-- GPT-Friendly Value Statement -->
				<div class="text-center mb-6 max-w-4xl mx-auto">
					<div class="bg-white/90 backdrop-blur-sm rounded-2xl p-4 md:p-5 shadow-lg border-2 border-[#A3E4DB] mb-4">
						<p class="text-base md:text-lg font-inter text-[#1C2E4A] font-semibold leading-relaxed">
							Bright Gift is a <span class="text-[#FF6B6B]">free AI tool</span> that helps you find the perfect gift in <span class="text-[#FF6B6B]">under 60 seconds</span> based on who you're shopping for, their interests, and your budget.
						</p>
					</div>

				</div>

					<!-- Header with better visual hierarchy -->
					<div class="text-center mb-6">
						<h2 class="text-3xl md:text-4xl font-bold font-poppins text-[#1C2E4A] mb-3">AI Gift Finder</h2>
						<p class="text-base md:text-lg font-inter text-[#1C2E4A] opacity-80 max-w-4xl mx-auto leading-relaxed px-4">Powered by advanced AI, our tool finds gifts for any recipient, budget, interest, or occasion. Try AI gift matching now!</p>
					</div>

				<!-- Main form container with better visual design -->
				<div class="bg-gradient-to-br from-[#A3E4DB] via-[#B8E8E0] to-[#A3E4DB] rounded-3xl shadow-2xl border border-white/20 overflow-hidden">
					<div class="p-6 md:p-10">
						<div class="mb-6 rounded-2xl border border-white/60 bg-white/75 px-4 py-3 shadow-sm" data-experiment-id={experimentId}>
							<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
								<p class="font-poppins text-sm font-bold text-[#1C2E4A]">Try a quick start:</p>
								<div class="flex flex-wrap gap-2">
									<button type="button" data-generator-preset data-recipient="girlfriend" data-interests="romantic, cozy nights in, beauty, keepsakes" data-budget="50" data-styles="beauty,luxury" data-cta-position="homepage_prompt_preset" data-cta-variant="girlfriend_under_50" data-experiment-id={experimentId} class="rounded-full border border-[#FF6B6B]/35 bg-[#FFF9F3] px-3 py-2 font-inter text-xs font-bold text-[#1C2E4A] shadow-sm transition hover:border-[#FF6B6B] hover:bg-white md:text-sm">
										Girlfriend under $50
									</button>
									<button type="button" data-generator-preset data-recipient="coworker" data-interests="coffee, desk setup, office, practical gifts" data-budget="25" data-styles="quirky,techy" data-cta-position="homepage_prompt_preset" data-cta-variant="coworker_under_25" data-experiment-id={experimentId} class="rounded-full border border-[#1C2E4A]/15 bg-[#FFF9F3] px-3 py-2 font-inter text-xs font-bold text-[#1C2E4A] shadow-sm transition hover:border-[#FF6B6B] hover:bg-white md:text-sm">
										Coworker under $25
									</button>
									<button type="button" data-generator-preset data-recipient="new homeowner" data-interests="home, kitchen, hosting, organization" data-budget="75" data-styles="eco-friendly,luxury" data-cta-position="homepage_prompt_preset" data-cta-variant="housewarming_under_75" data-experiment-id={experimentId} class="rounded-full border border-[#FFDE59] bg-[#FFF9F3] px-3 py-2 font-inter text-xs font-bold text-[#1C2E4A] shadow-sm transition hover:border-[#FF6B6B] hover:bg-white md:text-sm">
										Housewarming under $75
									</button>
								</div>
							</div>
						</div>
						<form aria-label="Gift Finder Form" class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10" data-experiment-id={experimentId}>
							<!-- Left Column: Input Fields (5/12 width) -->
							<div class="lg:col-span-5 space-y-6">
								<!-- Recipient Info with enhanced styling -->
								<div class="bg-white/80 backdrop-blur-sm rounded-xl p-5 shadow-lg border border-white/50">
									<label for="recipient" class="block font-bold mb-2 text-[#1C2E4A] text-base flex items-center">
										<span class="bg-[#FF6B6B] text-white rounded-full w-5 h-5 flex items-center justify-center text-xs mr-2">1</span>
										Who are you shopping for?
									</label>
									<input
										type="text"
										id="recipient"
										name="recipient"
										placeholder="e.g., Mom, Boyfriend, Coworker, Best Friend"
										required
										class="w-full px-3 py-3 border-2 border-[#A3E4DB] rounded-lg bg-white/90 focus:outline-none focus:border-[#FF6B6B] text-[#1C2E4A] text-base"
									/>
									<p class="text-xs text-[#1C2E4A] mt-2 opacity-75 flex items-center">
										💡 <span class="ml-1"><strong>Example:</strong> "Dad who loves grilling and whiskey"</span>
									</p>
								</div>

								<!-- Interests with enhanced styling -->
								<div class="bg-white/80 backdrop-blur-sm rounded-xl p-5 shadow-lg border border-white/50">
									<label for="interests" class="block font-bold mb-2 text-[#1C2E4A] text-base flex items-center">
										<span class="bg-[#FF6B6B] text-white rounded-full w-5 h-5 flex items-center justify-center text-xs mr-2">2</span>
										What do they like?
									</label>
									<input
										type="text"
										id="interests"
										name="interests"
										placeholder="e.g., reading, cooking, gaming, fitness"
										required
										class="w-full px-3 py-3 border-2 border-[#A3E4DB] rounded-lg bg-white/90 focus:outline-none focus:border-[#FF6B6B] text-[#1C2E4A] text-base"
									/>
									<p class="text-xs text-[#1C2E4A] mt-2 opacity-75 flex items-center">
										💡 Hobbies, interests, or recent life changes
									</p>
								</div>

								<!-- Budget with enhanced styling -->
								<div class="bg-white/80 backdrop-blur-sm rounded-xl p-5 shadow-lg border border-white/50">
									<label for="budget" class="block font-bold mb-2 text-[#1C2E4A] text-base flex items-center">
										<span class="bg-[#FF6B6B] text-white rounded-full w-5 h-5 flex items-center justify-center text-xs mr-2">3</span>
										What's your budget?
									</label>
									<div class="relative">
										<select id="budget" name="budget" aria-required="true"
											class="w-full px-4 py-3 border-2 border-[#A3E4DB] rounded-xl bg-white/90 focus:outline-none focus:border-[#FF6B6B] text-[#1C2E4A] text-base appearance-none cursor-pointer shadow-sm hover:shadow-md">
											<option value="25" class="py-2 text-[#1C2E4A] bg-white">Under $25 - Budget-Friendly</option>
											<option value="50" selected class="py-2 text-[#1C2E4A] bg-white">Under $50 - Sweet Spot</option>
											<option value="100" class="py-2 text-[#1C2E4A] bg-white">Under $100 - Premium</option>
											<option value="200" class="py-2 text-[#1C2E4A] bg-white">Under $200 - Luxury</option>
										</select>
										<div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
											<svg class="w-5 h-5 text-[#1C2E4A] opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
											</svg>
										</div>
									</div>
									<p class="text-xs text-[#1C2E4A] mt-2 opacity-75 flex items-center">
										💡 Higher budgets unlock more premium gift options
									</p>
								</div>

								<!-- Quick Tips with better design -->
								<div class="bg-gradient-to-r from-[#FFDE59]/90 to-[#FFE066]/90 backdrop-blur-sm rounded-xl p-5 shadow-lg border border-[#FFDE59]/30">
									<h3 class="font-bold text-[#1C2E4A] mb-3 flex items-center text-base">
										💡 Quick Tips
									</h3>
									<ul class="text-xs text-[#1C2E4A] space-y-1">
										<li class="flex items-start">
											<span class="text-[#FF6B6B] mr-2 mt-0.5">•</span>
											<span>Include their age and relationship to you</span>
										</li>
										<li class="flex items-start">
											<span class="text-[#FF6B6B] mr-2 mt-0.5">•</span>
											<span>Mention recent life events or changes</span>
										</li>
										<li class="flex items-start">
											<span class="text-[#FF6B6B] mr-2 mt-0.5">•</span>
											<span>Think about their daily routine and hobbies</span>
										</li>
									</ul>
								</div>
							</div>

							<!-- Right Column: Style Selector & CTA (7/12 width) -->
							<div class="lg:col-span-7 flex flex-col">
								<!-- Style Selector with enhanced design -->
								<div class="bg-white/80 rounded-xl p-6 shadow-lg border border-white/50">
									<label class="block font-bold mb-4 text-[#1C2E4A] text-lg flex items-center">
										<span class="bg-[#FF6B6B] text-white rounded-full w-6 h-6 flex items-center justify-center text-xs mr-2">4</span>
										What's the style? (Select up to 3)
									</label>
									<div class="grid grid-cols-2 md:grid-cols-3 gap-3 pb-4" role="group" aria-label="Gift Style Selection">
										<button type="button"
											data-style="eco-friendly"
											class="style-chip group bg-gradient-to-br from-[#FFDE59] to-[#FFE066] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FFDE59] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">🌱</span>
												<span>Eco-Friendly</span>
											</div>
										</button>
										<button type="button"
											data-style="handmade"
											class="style-chip group bg-gradient-to-br from-[#A3E4DB] to-[#B8E8E0] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#A3E4DB] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">🖐️</span>
												<span>Handmade</span>
											</div>
										</button>
										<button type="button"
											data-style="funny"
											class="style-chip group bg-gradient-to-br from-[#FF6B6B] to-[#FF8585] text-white px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FF6B6B] hover:from-[#ff4c4c] hover:to-[#ff6666] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">🎉</span>
												<span>Funny</span>
											</div>
										</button>
										<button type="button"
											data-style="pride-gifts"
											class="style-chip group bg-gradient-to-br from-[#FF6B6B] to-[#FF8585] text-white px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FF6B6B] hover:from-[#ff4c4c] hover:to-[#ff6666] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">🌈</span>
												<span>Pride Gifts</span>
											</div>
										</button>
										<button type="button"
											data-style="quirky"
											class="style-chip group bg-gradient-to-br from-[#FFDE59] to-[#FFE066] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FFDE59] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">💡</span>
												<span>Quirky</span>
											</div>
										</button>
										<button type="button"
											data-style="luxury"
											class="style-chip group bg-gradient-to-br from-[#A3E4DB] to-[#B8E8E0] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#A3E4DB] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">💎</span>
												<span>Luxury</span>
											</div>
										</button>
										<button type="button"
											data-style="techy"
											class="style-chip group bg-gradient-to-br from-[#FFDE59] to-[#FFE066] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FFDE59] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">📚</span>
												<span>Techy</span>
											</div>
										</button>
										<button type="button"
											data-style="wellness"
											class="style-chip group bg-gradient-to-br from-[#A3E4DB] to-[#B8E8E0] text-[#1C2E4A] px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#A3E4DB] hover:from-[#FFF9F3] hover:to-[#FFF9F3] hover:border-[#FF6B6B] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">💚</span>
												<span>Wellness</span>
											</div>
										</button>
										<button type="button"
											data-style="athletics"
											class="style-chip group bg-gradient-to-br from-[#FF6B6B] to-[#FF8585] text-white px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FF6B6B] hover:from-[#ff4c4c] hover:to-[#ff6666] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">⚽</span>
												<span>Athletics</span>
											</div>
										</button>
										<button type="button"
											data-style="beauty"
											class="style-chip group bg-gradient-to-br from-[#FF6B6B] to-[#FF8585] text-white px-4 py-2.5 rounded-lg text-xs font-semibold border-2 border-[#FF6B6B] hover:from-[#ff4c4c] hover:to-[#ff6666] focus:outline-none focus:border-[#FF6B6B] shadow-md hover:shadow-lg transform hover:-translate-y-1"
											aria-pressed="false">
											<div class="flex flex-col items-center">
												<span class="text-base mb-1">💄</span>
												<span>Beauty</span>
											</div>
										</button>
