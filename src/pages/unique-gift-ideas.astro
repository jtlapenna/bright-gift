---
import Layout from '../layouts/Layout.astro';

const metaDescription = "Skip generic gifts. Our AI finds unique, creative gift ideas tailored to each person's interests and personality. Discover gifts they'll actually remember.";
---

<Layout 
	title="Unique Gift Ideas | AI Gift Finder"
	description={metaDescription}
	canonical="https://bright-gift.com/unique-gift-ideas/"
>
	<main class="font-sans text-gray-800 dark:text-gray-200">
		<section class="py-20 px-4 bg-gradient-to-br from-[#FEF2D3] to-[#FFDE59]/30">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl md:text-5xl font-bold font-poppins text-[#1C2E4A] mb-6">
					✨ Unique Gift Ideas
				</h1>
				<p class="text-lg md:text-xl text-[#1C2E4A] mb-8 leading-relaxed">
					Tired of giving the same gifts everyone else gives? Our AI discovers unique, creative gifts that match each person's personality and interests—no more generic gift guides.
				</p>
				
				<div class="bg-white/90 rounded-2xl p-8 shadow-lg mb-8">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">What Makes a Gift Unique?</h2>
					<ul class="text-left text-[#1C2E4A] space-y-3 max-w-2xl mx-auto">
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎯</span>
							<span>Tailored to their specific interests (not generic)</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">💡</span>
							<span>Something they wouldn't buy for themselves</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🌟</span>
							<span>Unexpected and creative (not obvious)</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">❤️</span>
							<span>Shows you understand who they are</span>
						</li>
					</ul>
				</div>
				
				<div class="bg-gradient-to-r from-[#FF6B6B] to-[#ff4c4c] rounded-2xl p-8 shadow-lg text-white">
					<h2 class="text-2xl font-bold mb-4">Discover Truly Unique Gifts</h2>
					<p class="mb-6">
						Our AI analyzes their personality and suggests creative gifts you won't find in typical gift guides. Every recommendation is personalized.
					</p>
					<a href="/#tool" class="inline-block bg-white text-[#FF6B6B] font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-lg hover:bg-gray-100">
						Find Unique Gifts Now →
					</a>
				</div>
			</div>
		</section>
		
		<section class="py-16 px-4 bg-white">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-[#1C2E4A] mb-4">Use the AI Gift Finder Above</h2>
				<p class="text-lg text-[#1C2E4A] mb-8">
					The more details you provide, the more unique and personalized the suggestions.
				</p>
				<a href="/#tool" class="inline-block bg-[#A3E4DB] hover:bg-[#8cd4ca] text-[#1C2E4A] font-bold py-3 px-8 rounded-full transition-colors text-lg shadow">
					Try the AI Gift Finder
				</a>
			</div>
		</section>
	</main>
</Layout>

