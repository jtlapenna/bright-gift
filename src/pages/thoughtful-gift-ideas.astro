---
import Layout from '../layouts/Layout.astro';
import { buildGeneratorPrefillHref } from '../utils/generatorPrefill';

const metaDescription = "Find thoughtful, meaningful gifts that show you care. Our AI suggests personalized gift ideas based on their interests, lifestyle, and what makes them unique.";
const thoughtfulPrefillHref = buildGeneratorPrefillHref({
	recipient: 'friend or loved one',
	interests: 'thoughtful gifts, keepsakes, self-care, useful upgrades, meaningful surprises',
	budget: 50,
	styles: 'thoughtful,practical',
	sourceCta: 'thoughtful_gift_page_cta',
	sourceVariant: 'thoughtful_gift_finder',
	sourceExperiment: 'bg-generator-prefill-qa-202607'
});
---

<Layout 
	title="Thoughtful Gift Ideas | AI Gift Finder"
	description={metaDescription}
	canonical="https://bright-gift.com/thoughtful-gift-ideas/"
>
	<main class="font-sans text-gray-800 dark:text-gray-200">
		<section class="py-20 px-4 bg-gradient-to-br from-[#FEF2D3] to-[#FFDE59]/30">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl md:text-5xl font-bold font-poppins text-[#1C2E4A] mb-6">
					💝 Thoughtful Gift Ideas
				</h1>
				<p class="text-lg md:text-xl text-[#1C2E4A] mb-8 leading-relaxed">
					The best gifts aren't the most expensive—they're the most thoughtful. Our AI helps you find meaningful gifts that show you truly understand and care about the person.
				</p>
				
				<div class="bg-white/90 rounded-2xl p-8 shadow-lg mb-8">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">What Makes a Gift Thoughtful?</h2>
					<ul class="text-left text-[#1C2E4A] space-y-3 max-w-2xl mx-auto">
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">💭</span>
							<span>Shows you listen and remember details about them</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🎯</span>
							<span>Solves a problem they've mentioned</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">❤️</span>
							<span>Connects to their values or passions</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">✨</span>
							<span>Enhances something they already love doing</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#FF6B6B] mr-3 text-xl">🌟</span>
							<span>Feels personal, not generic</span>
						</li>
					</ul>
				</div>
				
				<div class="bg-gradient-to-r from-[#A3E4DB] to-[#B8E8E0] rounded-2xl p-8 shadow-lg">
					<h2 class="text-2xl font-bold text-[#1C2E4A] mb-4">Find Meaningful Gifts</h2>
					<p class="text-[#1C2E4A] mb-6">
						Share what you know about them—their hobbies, recent life changes, what they care about. Our AI will suggest gifts that feel personal and meaningful.
					</p>
					<a href={thoughtfulPrefillHref} class="inline-block bg-[#FF6B6B] hover:bg-[#ff4c4c] text-white font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-lg">
						Find Thoughtful Gifts Now →
					</a>
				</div>
			</div>
		</section>
		
		<section class="py-16 px-4 bg-white">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-[#1C2E4A] mb-4">Use the AI Gift Finder Above</h2>
				<p class="text-lg text-[#1C2E4A] mb-8">
					The more context you provide, the more thoughtful the recommendations.
				</p>
				<a href={thoughtfulPrefillHref} class="inline-block bg-[#A3E4DB] hover:bg-[#8cd4ca] text-[#1C2E4A] font-bold py-3 px-8 rounded-full transition-colors text-lg shadow">
					Try the AI Gift Finder
				</a>
			</div>
		</section>
	</main>
</Layout>
