---
import '../styles/tailwind.css';

export interface Props {
	title: string;
	metaTitle?: string; // SEO title (shorter, ≤60 chars)
	description?: string;
	metaDescription?: string; // SEO description (140-160 chars)
	image?: string;
	ogImage?: string;
	twitterImage?: string;
	keywords?: string[];
	canonical?: string;
	ogType?: string;
	twitterCard?: string;
	noindex?: boolean;
	robots?: string;
	prevPage?: string;
	nextPage?: string;
	breadcrumbs?: Array<{
		name: string;
		url: string;
	}>;
}

const { 
	title, 
	metaTitle, // Use metaTitle for title tag if provided (SEO-optimized, ≤60 chars)
	description = "Find the perfect gift in seconds with our AI-powered gift idea generator. Personalized recommendations for any recipient, budget, and occasion.",
	metaDescription, // Use metaDescription if provided (SEO-optimized, 140-160 chars)
	image = "/images/homepage-banner.webp",
	ogImage,
	twitterImage,
	keywords = ["gift ideas", "AI gifts", "personalized gifts", "gift finder", "gift recommendations", "birthday gifts", "holiday gifts"],
	canonical,
	ogType = "website",
	twitterCard = "summary_large_image",
	noindex = false,
	robots,
	prevPage,
	nextPage,
	breadcrumbs
} = Astro.props;

// Use metaTitle for title tag if provided, otherwise use title (truncate to 60 chars max)
const titleTag = metaTitle ? metaTitle.substring(0, 60) : title.substring(0, 60);
// Use metaDescription if provided, otherwise use description
const descriptionTag = metaDescription || description;
const robotsContent = robots || (noindex ? "noindex, nofollow" : "index, follow");

const isHome = Astro.url.pathname === "/";
// Ensure canonical URL uses HTTPS and proper format with trailing slash
// CRITICAL: Always use trailing slash for consistency (matches trailingSlash: 'always' config)
let canonicalUrl = canonical || Astro.url.href.replace('http://', 'https://');
// Ensure trailing slash for all non-root paths (unless already has query params or hash)
if (!canonical && !isHome && !canonicalUrl.includes('?') && !canonicalUrl.includes('#')) {
  const urlObj = new URL(canonicalUrl);
  if (!urlObj.pathname.endsWith('/') && urlObj.pathname !== '/') {
    urlObj.pathname += '/';
    canonicalUrl = urlObj.toString();
  }
}
const fullImageUrl = image.startsWith('http') ? image : new URL(image, Astro.site || Astro.url.origin).toString();
const resolvedOgImage = ogImage || image;
const resolvedTwitterImage = twitterImage || ogImage || image;
const fullOgImageUrl = resolvedOgImage.startsWith('http') ? resolvedOgImage : new URL(resolvedOgImage, Astro.site || Astro.url.origin).toString();
const fullTwitterImageUrl = resolvedTwitterImage.startsWith('http') ? resolvedTwitterImage : new URL(resolvedTwitterImage, Astro.site || Astro.url.origin).toString();

// Generate breadcrumb structured data
const breadcrumbStructuredData = breadcrumbs ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((crumb, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": crumb.name,
		"item": crumb.url
	}))
} : null;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="impact-site-verification" value="90ea2543-7bd4-4c66-a0cc-a822967ab0c9" />
		<meta name="fo-verify" content="84413cbb-5ed1-4125-8b5e-93bae176225d" />
		<meta name="p:domain_verify" content="268227acc207daf935166ab96a09f777" />
		
		<!-- Primary Meta Tags -->
		<title>{titleTag}</title>
		<meta name="title" content={titleTag} />
		<meta name="description" content={descriptionTag} />
		<meta name="keywords" content={Array.isArray(keywords) ? keywords.join(', ') : (typeof keywords === 'string' ? keywords : keywords?.toString() || '')} />
		<meta name="author" content="BrightGift" />
		<meta name="robots" content={robotsContent} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />
		
		
		<!-- Pagination Meta Tags -->
		{prevPage && <link rel="prev" href={prevPage} />}
		{nextPage && <link rel="next" href={nextPage} />}
		
		<!-- Favicon -->
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<link rel="manifest" href="/site.webmanifest" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={titleTag} />
		<meta property="og:description" content={descriptionTag} />
		<meta property="og:image" content={fullOgImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="BrightGift" />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={titleTag} />
		<meta name="twitter:description" content={descriptionTag} />
		<meta name="twitter:image" content={fullTwitterImageUrl} />
		<meta name="twitter:site" content="@brightgift" />
		<meta name="twitter:creator" content="@brightgift" />
		
		<!-- Additional SEO -->
		<meta name="theme-color" content="#FF6B6B" />
		<meta name="msapplication-TileColor" content="#FF6B6B" />
		<meta name="application-name" content="BrightGift" />
		
		<!-- Preconnect to external domains for performance -->
		<link rel="preconnect" href="https://bookshop.org" />
		<link rel="dns-prefetch" href="https://bookshop.org" />
		<link rel="preconnect" href="https://analytics.ahrefs.com" />
		
		<!-- Preconnect to main domain for critical resources -->
		<link rel="preconnect" href="https://bright-gift.com/" />
		<link rel="dns-prefetch" href="https://bright-gift.com/" />
		<!-- Resource hints for better performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="dns-prefetch" href="https://www.google-analytics.com" />
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		
		<!-- Preload critical resources -->
		<link rel="preload" href="/bright-gift-logo.webp" as="image" />
		<link rel="preload" href="/favicon.svg" as="image" />
		<link rel="preload" href="/hero-image-desktop.webp" as="image" media="(min-width: 769px)" />
		<link rel="preload" href="/hero-image-mobile.webp" as="image" media="(max-width: 768px)" />
		
		<!-- Remove brittle preloads of hashed CSS files. Astro will inject the correct CSS automatically. -->

		<!-- Ahrefs Web Analytics - Load asynchronously -->
		<script src="https://analytics.ahrefs.com/analytics.js" data-key="4JPGWiHF06I8NTlAvEpMtQ" async></script>

		<!-- Breadcrumb Structured Data -->
		{breadcrumbStructuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
		)}

		<!-- Amazon Link Processing Script - Defer to after page load -->
		<script is:inline>
        // Post-process affiliate links to ensure correct classes
		  document.addEventListener('DOMContentLoaded', function() {
		    const articleContent = document.getElementById('article-content');
		    if (articleContent) {
		      const links = articleContent.querySelectorAll('a');
		      links.forEach(link => {
                const href = (link.getAttribute('href') || '').toLowerCase();
                if (href.includes('amazon.com')) link.classList.add('amazon-link');
                if (href.includes('bookshop.org')) link.classList.add('bookshop-link');
                if (href.includes('arjdj2msd.com')) link.classList.add('afrofiliate-link');
		      });
		    }
		  });
		</script>
	</head>
	<body>
		{/* Navigation Header - Show on all pages */}
		<header class="w-full bg-[#FEF2D3] border-b border-slate-100 py-3 px-4 flex items-center justify-between">
			<a href="/" class="flex items-center gap-2">
				<picture>
					<source srcset="/bright-gift-logo-mobile.webp" media="(max-width: 768px)" />
					<source srcset="/bright-gift-logo.webp" media="(min-width: 769px)" />
					<img src="/bright-gift-logo.webp" alt="BrightGift logo" class="h-10 w-auto" style="display:inline-block;" />
				</picture>
				<span class="sr-only">BrightGift Home</span>
			</a>
			
			{/* Navigation Links */}
			<nav class="hidden md:flex gap-6 md:gap-8 font-semibold text-[#1C2E4A] text-base md:text-lg pr-4 md:pr-8">
				<a href="/" class="hover:underline underline-offset-4 rounded">Home</a>
				<a href="/blog/" class="hover:underline underline-offset-4 rounded">Blog</a>
				<a href="/#about-tool" class="hover:underline underline-offset-4 rounded">About</a>
				<a href="/#faq" class="hover:underline underline-offset-4 rounded">FAQ</a>
				<a href="/contact/" class="hover:underline underline-offset-4 rounded">Contact</a>
			</nav>
			
			{/* Mobile Menu Button */}
			<button class="md:hidden text-[#1C2E4A] p-2" id="mobile-menu-btn" aria-label="Toggle mobile menu">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</header>
		
		{/* Mobile Menu */}
		<div id="mobile-menu" class="md:hidden hidden bg-[#FEF2D3] border-b border-slate-100 py-4 px-4">
			<nav class="flex flex-col gap-4 font-semibold text-[#1C2E4A] text-base">
				<a href="/" class="hover:underline underline-offset-4 rounded">Home</a>
				<a href="/blog/" class="hover:underline underline-offset-4 rounded">Blog</a>
				<a href="/#about-tool" class="hover:underline underline-offset-4 rounded">About</a>
				<a href="/#faq" class="hover:underline underline-offset-4 rounded">FAQ</a>
				<a href="/contact/" class="hover:underline underline-offset-4 rounded">Contact</a>
			</nav>
		</div>
		
		<slot />

		{/* Footer - match homepage styling exactly */}
		<footer class="bg-[#1C2E4A] text-white text-sm py-6 mt-16 text-center">
			<div class="flex flex-col items-center gap-2">
				<span class="flex items-center gap-2">
					<img src="/bright-gift-logo.png" alt="BrightGift logo" class="h-6 inline" />
					<span>BrightGift &copy; {new Date().getFullYear()}</span>
				</span>
				<span>
					<a href="/#about-tool" class="underline hover:no-underline">About</a> &middot;
					<a href="/blog/" class="underline hover:no-underline">Blog</a> &middot;
					<a href="/privacy/" class="underline hover:no-underline">Privacy</a> &middot;
					<a href="/terms/" class="underline hover:no-underline">Terms</a> &middot;
					<a href="/data-deletion/" class="underline hover:no-underline">Data Deletion</a>
				</span>
				<span class="opacity-70">"Find the Perfect Gift with AI!"</span>
			</div>
		</footer>
		
		
		<!-- Google Tag Manager - Load after page content with optimized loading -->
		<script is:inline>
		  // Optimized GTM loading to reduce unused JavaScript
		  window.addEventListener('load', function() {
		    // Delay GTM loading by 3 seconds to prioritize page content
		    setTimeout(function() {
		      // Google Tag Manager
		      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		      })(window,document,'script','dataLayer','GTM-W7B2JFWV');
		      
		      // Google Analytics - Load only essential tracking
		      var gaScript = document.createElement('script');
		      gaScript.async = true;
		      gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-9T1R5LN5VG';
		      document.head.appendChild(gaScript);
		      
		      gaScript.onload = function() {
		        window.dataLayer = window.dataLayer || [];
		        function gtag(){dataLayer.push(arguments);}
		        gtag('js', new Date());
		        gtag('config', 'G-9T1R5LN5VG', {
		          'send_page_view': false, // Disable automatic page view
		          'anonymize_ip': true, // Anonymize IP for privacy
		          'cookie_flags': 'SameSite=None;Secure' // Secure cookies
		        });
		      };
		    }, 3000); // 3 second delay (increased from 2)
		  });
		</script>
		
		<!-- Mobile Menu JavaScript -->
		<script is:inline>
		  document.addEventListener('DOMContentLoaded', function() {
		    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
		    const mobileMenu = document.getElementById('mobile-menu');
		    
		    if (mobileMenuBtn && mobileMenu) {
		      mobileMenuBtn.addEventListener('click', function() {
		        const isHidden = mobileMenu.classList.contains('hidden');
		        if (isHidden) {
		          mobileMenu.classList.remove('hidden');
		          mobileMenuBtn.setAttribute('aria-expanded', 'true');
		        } else {
		          mobileMenu.classList.add('hidden');
		          mobileMenuBtn.setAttribute('aria-expanded', 'false');
		        }
		      });
		    }
		  });
		</script>
		
		<!-- Google Tag Manager (noscript) - Fallback for users with JavaScript disabled -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W7B2JFWV"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	</body>
</html> 
