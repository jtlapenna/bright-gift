---
import '../styles/tailwind.css';

export interface Props {
	title: string;
	metaTitle?: string; // SEO title (shorter, ≤60 chars)
	description?: string;
	metaDescription?: string; // SEO description (140-160 chars)
	image?: string;
	ogImage?: string;
	twitterImage?: string;
	imageWidth?: number;
	imageHeight?: number;
	ogImageWidth?: number;
	ogImageHeight?: number;
	keywords?: string[];
	canonical?: string;
	ogType?: string;
	twitterCard?: string;
	noindex?: boolean;
	robots?: string;
	prevPage?: string;
	nextPage?: string;
	breadcrumbs?: Array<{
		name: string;
		url: string;
	}>;
}

const { 
	title, 
	metaTitle, // Use metaTitle for title tag if provided (SEO-optimized, ≤60 chars)
	description = "Find the perfect gift in seconds with our AI-powered gift idea generator. Personalized recommendations for any recipient, budget, and occasion.",
	metaDescription, // Use metaDescription if provided (SEO-optimized, 140-160 chars)
	image = "/images/homepage-banner.webp",
	ogImage,
	twitterImage,
	imageWidth = 1200,
	imageHeight = 630,
	ogImageWidth,
	ogImageHeight,
	keywords = ["gift ideas", "AI gifts", "personalized gifts", "gift finder", "gift recommendations", "birthday gifts", "holiday gifts"],
	canonical,
	ogType = "website",
	twitterCard = "summary_large_image",
	noindex = false,
	robots,
	prevPage,
	nextPage,
	breadcrumbs
} = Astro.props;

// Use metaTitle for title tag if provided, otherwise use title (truncate to 60 chars max)
const titleTag = metaTitle ? metaTitle.substring(0, 60) : title.substring(0, 60);
// Use metaDescription if provided, otherwise use description
const descriptionTag = metaDescription || description;
const robotsContent = robots || (noindex ? "noindex, nofollow" : "index, follow");

const isHome = Astro.url.pathname === "/";
// Ensure canonical URL uses HTTPS and proper format with trailing slash
// CRITICAL: Always use trailing slash for consistency (matches trailingSlash: 'always' config)
let canonicalUrl = canonical || Astro.url.href.replace('http://', 'https://');
// Ensure trailing slash for all non-root paths (unless already has query params or hash)
if (!canonical && !isHome && !canonicalUrl.includes('?') && !canonicalUrl.includes('#')) {
  const urlObj = new URL(canonicalUrl);
  if (!urlObj.pathname.endsWith('/') && urlObj.pathname !== '/') {
    urlObj.pathname += '/';
    canonicalUrl = urlObj.toString();
  }
}
const fullImageUrl = image.startsWith('http') ? image : new URL(image, Astro.site || Astro.url.origin).toString();
const resolvedOgImage = ogImage || image;
const resolvedTwitterImage = twitterImage || ogImage || image;
const resolvedOgImageWidth = ogImageWidth || imageWidth;
const resolvedOgImageHeight = ogImageHeight || imageHeight;
const fullOgImageUrl = resolvedOgImage.startsWith('http') ? resolvedOgImage : new URL(resolvedOgImage, Astro.site || Astro.url.origin).toString();
const fullTwitterImageUrl = resolvedTwitterImage.startsWith('http') ? resolvedTwitterImage : new URL(resolvedTwitterImage, Astro.site || Astro.url.origin).toString();

// Generate breadcrumb structured data
const breadcrumbStructuredData = breadcrumbs ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((crumb, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": crumb.name,
		"item": crumb.url
	}))
} : null;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="impact-site-verification" value="90ea2543-7bd4-4c66-a0cc-a822967ab0c9" />
		<meta name="fo-verify" content="84413cbb-5ed1-4125-8b5e-93bae176225d" />
		<meta name="p:domain_verify" content="268227acc207daf935166ab96a09f777" />
		
		<!-- Primary Meta Tags -->
		<title>{titleTag}</title>
		<meta name="title" content={titleTag} />
		<meta name="description" content={descriptionTag} />
		<meta name="keywords" content={Array.isArray(keywords) ? keywords.join(', ') : (typeof keywords === 'string' ? keywords : keywords?.toString() || '')} />
		<meta name="author" content="BrightGift" />
		<meta name="robots" content={robotsContent} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />
		
		
		<!-- Pagination Meta Tags -->
		{prevPage && <link rel="prev" href={prevPage} />}
		{nextPage && <link rel="next" href={nextPage} />}
		
		<!-- Favicon -->
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<link rel="manifest" href="/site.webmanifest" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={titleTag} />
		<meta property="og:description" content={descriptionTag} />
		<meta property="og:image" content={fullOgImageUrl} />
		<meta property="og:image:width" content={resolvedOgImageWidth.toString()} />
		<meta property="og:image:height" content={resolvedOgImageHeight.toString()} />
		<meta property="og:site_name" content="BrightGift" />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={titleTag} />
		<meta name="twitter:description" content={descriptionTag} />
		<meta name="twitter:image" content={fullTwitterImageUrl} />
		<meta name="twitter:site" content="@brightgift" />
		<meta name="twitter:creator" content="@brightgift" />
		
		<!-- Additional SEO -->
		<meta name="theme-color" content="#FF6B6B" />
		<meta name="msapplication-TileColor" content="#FF6B6B" />
		<meta name="application-name" content="BrightGift" />
		
		<!-- Preconnect to external domains for performance -->
		<link rel="preconnect" href="https://bookshop.org" />
		<link rel="dns-prefetch" href="https://bookshop.org" />
		<link rel="preconnect" href="https://analytics.ahrefs.com" />
		
		<!-- Preconnect to main domain for critical resources -->
		<link rel="preconnect" href="https://bright-gift.com/" />
		<link rel="dns-prefetch" href="https://bright-gift.com/" />
		<!-- Resource hints for better performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="dns-prefetch" href="https://www.google-analytics.com" />
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		
		<!-- Preload critical resources -->
		<link rel="preload" href="/bright-gift-logo.webp" as="image" />
		<link rel="preload" href="/favicon.svg" as="image" />
		<link rel="preload" href="/hero-image-desktop.webp" as="image" media="(min-width: 769px)" />
		<link rel="preload" href="/hero-image-mobile.webp" as="image" media="(max-width: 768px)" />
		
		<!-- Remove brittle preloads of hashed CSS files. Astro will inject the correct CSS automatically. -->

			<!-- Ahrefs Web Analytics - Load asynchronously -->
			<script src="https://analytics.ahrefs.com/analytics.js" data-key="4JPGWiHF06I8NTlAvEpMtQ" async></script>

			<!-- Google Analytics - direct GA4 instrumentation for reliable page and event tracking -->
			<script async src="https://www.googletagmanager.com/gtag/js?id=G-9T1R5LN5VG"></script>
			<script is:inline>
			  window.dataLayer = window.dataLayer || [];
			  window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
			  window.brightGiftGaDebug = false;
			  try {
			    var gaDebugParams = new URLSearchParams(window.location.search);
			    if (gaDebugParams.get('ga_debug') === '1') {
			      window.localStorage.setItem('brightgift_ga_debug', '1');
			    }
			    if (gaDebugParams.get('ga_debug') === '0') {
			      window.localStorage.removeItem('brightgift_ga_debug');
			    }
			    window.brightGiftGaDebug = gaDebugParams.get('ga_debug') === '1' || window.localStorage.getItem('brightgift_ga_debug') === '1';
			  } catch (error) {
			    window.brightGiftGaDebug = false;
			  }

			  var brightGiftGaConfig = {
			    anonymize_ip: true,
			    cookie_flags: 'SameSite=None;Secure',
			    transport_type: 'beacon',
			    send_page_view: false
			  };
			  if (window.brightGiftGaDebug) {
			    brightGiftGaConfig.debug_mode = true;
			  }

			  window.gtag('js', new Date());
			  window.gtag('config', 'G-9T1R5LN5VG', brightGiftGaConfig);

			  window.brightGiftTrack = function(eventName, params) {
			    var eventParams = Object.assign({
			      page_location: window.location.href,
			      page_path: window.location.pathname,
			      page_title: document.title
			    }, params || {});
			    if (window.brightGiftGaDebug) {
			      eventParams.debug_mode = true;
			    }

			    window.dataLayer.push(Object.assign({ event: eventName }, eventParams));

			    if (typeof window.gtag === 'function') {
			      window.gtag('event', eventName, eventParams);
			    }
			  };

			  window.brightGiftTrack('page_view');
			</script>

			<!-- Breadcrumb Structured Data -->
			{breadcrumbStructuredData && (
				<script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
			)}

		<!-- Affiliate click/impression tracking -->
		<script is:inline>
			(function() {
				var SITE = 'brightgift';
				var TRACKING_VERSION = '2026-05-21';
				var AMAZON_TRACKING_ID = 'bright-gift-20';
				var BOOKSHOP_AFFILIATE_ID = 'brightgift';

				function getUrl(href) {
					try {
						return new URL(href, window.location.origin);
					} catch {
						return null;
					}
				}

				function getAsin(url) {
					var match = url.href.match(/\/(?:dp|gp\/product)\/([A-Z0-9]{10})(?:[/?#]|$)/i);
					return match ? match[1].toUpperCase() : '';
				}

				function getPartner(url) {
					var href = url.href.toLowerCase();
					if (href.includes('amazon.') || href.includes('amzn.to')) return 'amazon';
					if (href.includes('bookshop.org')) return 'bookshop';
					if (href.includes('arjdj2msd.com')) return 'afrofiliate';
					if (href.includes('littleherolabs.com')) return 'little_hero_labs';
					if (href.includes('impact.com')) return 'impact';
					if (href.includes('flexoffers.com')) return 'flexoffers';
					return 'other';
				}

				function isAffiliateLink(href) {
					var url = getUrl(href);
					if (!url) return false;
					return getPartner(url) !== 'other';
				}

				function getContentType() {
					var path = window.location.pathname;
					if (path === '/') return 'home';
					if (path.includes('/blog/')) return 'blog_post';
					if (path.includes('/gift-idea-generator/')) return 'tool';
					if (path.includes('/category/')) return 'category';
					return 'page';
				}

				function getCtaPosition(link) {
					if (link.dataset.ctaPosition) return link.dataset.ctaPosition;
					if (link.closest('#results-container')) return 'gift_generator_result';
					if (link.closest('#article-content')) return 'blog_article';
					if (link.closest('header')) return 'header';
					if (link.closest('footer')) return 'footer';
					if (link.textContent && /shop|buy|find|view|amazon|bookshop|create/i.test(link.textContent)) return 'inline_cta';
					return 'inline';
				}

				function getTrackingId(url, partner) {
					if (partner === 'amazon') return url.searchParams.get('tag') || AMAZON_TRACKING_ID;
					if (partner === 'bookshop') return url.searchParams.get('affiliate') || BOOKSHOP_AFFILIATE_ID;
					if (partner === 'afrofiliate') {
						var parts = url.pathname.split('/').filter(Boolean);
						return parts.slice(0, 3).join('/');
					}
					return url.searchParams.get('tag') || url.searchParams.get('affiliate') || url.searchParams.get('subid') || '';
				}

				function getProductName(link, url, partner) {
					var label = link.dataset.productName || link.getAttribute('aria-label') || link.textContent || '';
					var productName = label
						.replace(/\s+/g, ' ')
						.replace(/^view\s+/i, '')
						.replace(/\s+\((affiliate )?link\)$/i, '')
						.trim();
					var normalizedLabel = productName.replace(/[→›»]/g, '').trim();
					var isGenericLabel = !normalizedLabel || /^(on amazon|on bookshop|find on amazon|find similar on amazon|find similar products on amazon|shop now|shop|buy now|view details|details)$/i.test(normalizedLabel);
					if (productName && !isGenericLabel) return productName.slice(0, 120);
					if (partner === 'amazon') return url.searchParams.get('k') || getAsin(url) || 'Amazon product';
					if (partner === 'bookshop') return url.searchParams.get('keywords') || 'Bookshop product';
					return partner;
				}

				function getProductId(link, url, partner) {
					if (link.dataset.productId) return link.dataset.productId;
					var asin = getAsin(url);
					if (asin) return asin;
					if (partner === 'amazon') return url.searchParams.get('k') || '';
					if (partner === 'bookshop') return url.pathname.split('/').filter(Boolean).pop() || url.searchParams.get('keywords') || '';
					return '';
				}

				function getInternalQaMarker() {
					try {
						var params = new URLSearchParams(window.location.search);
						if (params.get('act_qa') === '1' || params.get('codex_qa') === '1') return 'internal_qa';
						if (window.localStorage && window.localStorage.getItem('affiliate_control_tower_qa') === '1') return 'internal_qa';
					} catch {
						return '';
					}
					return '';
				}

				function getPayload(link) {
					var url = getUrl(link.href);
					if (!url) return null;
					var partner = getPartner(url);
					if (partner === 'other') return null;
					var internalQaMarker = getInternalQaMarker();
					var productName = getProductName(link, url, partner);
					return {
						site: SITE,
						page_url: window.location.pathname,
						page_title: document.title,
						content_type: getContentType(),
						partner: partner,
						retailer: link.dataset.retailer || partner,
						product_id: getProductId(link, url, partner),
						product_name: productName,
						asin: getAsin(url),
						affiliate_tracking_id: getTrackingId(url, partner),
						link_url: url.href,
						cta_position: getCtaPosition(link),
						cta_variant: link.dataset.ctaVariant || (link.textContent || '').trim().slice(0, 120),
						experiment_id: internalQaMarker || link.dataset.experimentId || (link.closest('[data-experiment-id]') && link.closest('[data-experiment-id]').dataset.experimentId) || '',
						traffic_type: internalQaMarker,
						tracking_version: TRACKING_VERSION,
						event_category: 'Affiliate',
						event_label: partner + ' - ' + productName
					};
				}

				function sendEvent(eventName, payload) {
					if (!payload || typeof window.brightGiftTrack !== 'function') return;
					window.brightGiftTrack(eventName, payload);
				}

				function trackAffiliateClick(linkOrEvent) {
					var link = linkOrEvent && linkOrEvent.target && typeof linkOrEvent.target.closest === 'function'
						? linkOrEvent.target.closest('a[href]')
						: linkOrEvent;
					if (!link || !link.href || !isAffiliateLink(link.href)) return;
					var payload = getPayload(link);
					link.dataset.standardAffiliateTracked = 'true';
					sendEvent('affiliate_click', payload);
					if (payload && payload.partner === 'amazon') {
						sendEvent('amazon_click', payload);
					}
				}

				function trackClick(event) {
					var target = event.target;
					if (!(target instanceof Element)) return;
					var link = target.closest('a[href]');
					if (!link || !isAffiliateLink(link.href)) return;
					if (event.standardAffiliateTrackingHandled) return;
					event.standardAffiliateTrackingHandled = true;
					trackAffiliateClick(link);
				}

				function classifyLinks() {
					document.querySelectorAll('a[href]').forEach(function(link) {
						var partner = getPartner(getUrl(link.href) || { href: '' });
						if (partner === 'amazon') link.classList.add('amazon-link');
						if (partner === 'bookshop') link.classList.add('bookshop-link');
						if (partner === 'afrofiliate') link.classList.add('afrofiliate-link');
					});
				}

				function trackImpressions() {
					classifyLinks();
					var links = Array.from(document.querySelectorAll('a[href]')).filter(function(link) {
						return isAffiliateLink(link.href) && !link.dataset.ctaImpressionTracked;
					});
					if (!links.length) return;

					if (!('IntersectionObserver' in window)) {
						links.forEach(function(link) {
							link.dataset.ctaImpressionTracked = 'true';
							sendEvent('cta_impression', getPayload(link));
						});
						return;
					}

					var observer = new IntersectionObserver(function(entries) {
						entries.forEach(function(entry) {
							if (!entry.isIntersecting) return;
							var link = entry.target;
							if (link.dataset.ctaImpressionTracked) return;
							link.dataset.ctaImpressionTracked = 'true';
							sendEvent('cta_impression', getPayload(link));
							observer.unobserve(link);
						});
					}, { threshold: 0.5 });

					links.forEach(function(link) {
						observer.observe(link);
					});
				}

				window.trackAffiliateClick = trackAffiliateClick;
				window.addEventListener('click', trackClick, true);
				document.addEventListener('click', trackClick, true);
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', trackImpressions);
				} else {
					trackImpressions();
				}

				new MutationObserver(function() {
					trackImpressions();
				}).observe(document.documentElement, { childList: true, subtree: true });
			})();
		</script>
	</head>
	<body>
		{/* Navigation Header - Show on all pages */}
		<header class="w-full bg-[#FEF2D3] border-b border-slate-100 py-3 px-4 flex items-center justify-between">
			<a href="/" class="flex items-center gap-2">
				<picture>
					<source srcset="/bright-gift-logo-mobile.webp" media="(max-width: 768px)" />
					<source srcset="/bright-gift-logo.webp" media="(min-width: 769px)" />
					<img src="/bright-gift-logo.webp" alt="BrightGift logo" class="h-10 w-auto" style="display:inline-block;" />
				</picture>
				<span class="sr-only">BrightGift Home</span>
			</a>
			
			{/* Navigation Links */}
			<nav class="hidden md:flex gap-6 md:gap-8 font-semibold text-[#1C2E4A] text-base md:text-lg pr-4 md:pr-8">
				<a href="/" class="hover:underline underline-offset-4 rounded">Home</a>
				<a href="/gift-idea-generator/" class="hover:underline underline-offset-4 rounded">Gift Generator</a>
				<a href="/blog/" class="hover:underline underline-offset-4 rounded">Blog</a>
				<a href="/#about-tool" class="hover:underline underline-offset-4 rounded">About</a>
				<a href="/#faq" class="hover:underline underline-offset-4 rounded">FAQ</a>
				<a href="/contact/" class="hover:underline underline-offset-4 rounded">Contact</a>
			</nav>
			
			{/* Mobile Menu Button */}
			<button class="md:hidden text-[#1C2E4A] p-2" id="mobile-menu-btn" aria-label="Toggle mobile menu">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</header>
		
		{/* Mobile Menu */}
		<div id="mobile-menu" class="md:hidden hidden bg-[#FEF2D3] border-b border-slate-100 py-4 px-4">
			<nav class="flex flex-col gap-4 font-semibold text-[#1C2E4A] text-base">
				<a href="/" class="hover:underline underline-offset-4 rounded">Home</a>
				<a href="/gift-idea-generator/" class="hover:underline underline-offset-4 rounded">Gift Generator</a>
				<a href="/blog/" class="hover:underline underline-offset-4 rounded">Blog</a>
				<a href="/#about-tool" class="hover:underline underline-offset-4 rounded">About</a>
				<a href="/#faq" class="hover:underline underline-offset-4 rounded">FAQ</a>
				<a href="/contact/" class="hover:underline underline-offset-4 rounded">Contact</a>
			</nav>
		</div>
		
		<slot />

		{/* Footer - match homepage styling exactly */}
		<footer class="bg-[#1C2E4A] text-white text-sm py-6 mt-16 text-center">
			<div class="flex flex-col items-center gap-2">
				<span class="flex items-center gap-2">
					<img src="/bright-gift-logo.png" alt="BrightGift logo" class="h-6 inline" />
					<span>BrightGift &copy; {new Date().getFullYear()}</span>
				</span>
				<span>
					<a href="/#about-tool" class="underline hover:no-underline">About</a> &middot;
					<a href="/gift-idea-generator/" class="underline hover:no-underline">Gift Generator</a> &middot;
					<a href="/blog/" class="underline hover:no-underline">Blog</a> &middot;
					<a href="/privacy/" class="underline hover:no-underline">Privacy</a> &middot;
					<a href="/terms/" class="underline hover:no-underline">Terms</a> &middot;
					<a href="/data-deletion/" class="underline hover:no-underline">Data Deletion</a>
				</span>
				<span class="opacity-70">"Find the Perfect Gift with AI!"</span>
			</div>
		</footer>
		<!-- Mobile Menu JavaScript -->
		<script is:inline>
		  document.addEventListener('DOMContentLoaded', function() {
		    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
		    const mobileMenu = document.getElementById('mobile-menu');
		    
		    if (mobileMenuBtn && mobileMenu) {
		      mobileMenuBtn.addEventListener('click', function() {
		        const isHidden = mobileMenu.classList.contains('hidden');
		        if (isHidden) {
		          mobileMenu.classList.remove('hidden');
		          mobileMenuBtn.setAttribute('aria-expanded', 'true');
		        } else {
		          mobileMenu.classList.add('hidden');
		          mobileMenuBtn.setAttribute('aria-expanded', 'false');
		        }
		      });
		    }
		  });
		</script>
	</body>
</html> 
