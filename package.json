{
  "name": "bright-gift",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run generate:sitemap",
    "prebuild:enhanced": "npm run seo:validate && node scripts/validate-images.js && npm run validate:links && npm run validate:categories && npm run validate:schema && npm run validate:yaml && npm run generate:sitemap",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-links": "node src/pages/broken-links-checker.js",
    "clean": "rm -rf dist",
    "compile": "tsc",
    "validate:yaml": "node scripts/validate-yaml.js",
    "validate:control-tower": "node ../scripts/analytics/validate-control-tower-site.mjs --site-key brightgift",
    "validate:style-system": "node ../scripts/analytics/audit-style-system.mjs --site-key brightgift",
    "validate:portfolio": "npm run validate:control-tower && npm run validate:style-system && npm run validate-fast",
    "validate-fast": "npm run validate:links && npm run validate:categories && npm run validate:yaml",
    "validate:links": "node scripts/validate-links.js",
    "validate:categories": "node scripts/validate-categories.js",
    "validate:schema": "node scripts/validate-schema.js",
    "validate:blog": "node scripts/blog-validator.js",
    "fix:blog": "node scripts/blog-fixer.js",
    "enhance:blog": "node scripts/blog-enhancer.js",
    "validate:preview": "node scripts/preview-validator.js",
    "fix:preview": "node scripts/preview-fixer.js",
    "enhance:preview": "node scripts/preview-enhancer.js",
    "postbuild": "node scripts/fix-cloudflare-routes.js && npm run fix:preview && npm run enhance:preview",
    "create-blog": "node scripts/create-blog-automation.js",
    "create-blog:gift-guide": "node scripts/create-blog-automation.js --type gift-guide",
    "create-blog:educational": "node scripts/create-blog-automation.js --type educational",
    "create-blog:data-driven": "node scripts/create-blog-automation.js --type data-driven",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "seo:validate": "node scripts/seo-validation/validate-all.js",
    "seo:validate:content": "node scripts/seo-validation/validate-content.js",
    "seo:validate:templates": "node scripts/seo-validation/validate-templates.js",
    "seo:validate:repo": "node scripts/seo-validation/validate-repo-policy.js",
    "seo:check": "npm run seo:validate && npm run build",
    "predeploy": "npm run seo:check",
    "test:redirects": "node scripts/test-all-redirects.js",
    "verify:redirects": "node scripts/verify-redirects.js",
    "generate:favicons": "node scripts/generate-favicons.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/markdown-remark": "^6.3.6",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^5.10.1",
    "cheerio": "^1.0.0-rc.12",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "marked": "^15.0.11",
    "node-fetch": "^2.6.12",
    "openai": "^5.8.2",
    "phosphor-icons": "^1.4.2",
    "phosphor-react": "^1.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "gift",
    "ideas",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "description": "BrightGift main project for gift idea generation"
}
