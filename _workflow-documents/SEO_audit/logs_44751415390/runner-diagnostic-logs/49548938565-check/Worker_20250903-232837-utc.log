              "lit": "set -euo pipefail\nstart=$(date +%s)\nstatus=\"\"\nreason=\"\"\nwhile true; do\n  status=$(curl -s -o /tmp/resp.json -w \"%{http_code}\" -X POST \"${BASE_URL}${CHECK_PATH}\" \\\n    -H 'content-type: application/json' \\\n    --data '{\"recipient\":\"friend\",\"interests\":\"books\",\"budget\":\"25\",\"styles\":[\"book-lover\"]}') || true\n  if [[ \"$status\" == \"200\" ]]; then\n    echo \"Generator healthy (200).\"\n    cat /tmp/resp.json | jq -e '.ideas and (.ideas | type==\"array\")' >/dev/null\n    break\n  fi\n  # If body includes our quota signal, fail immediately (tool unusable)\n  if grep -q \"OPENAI_QUOTA_REACHED\" /tmp/resp.json 2>/dev/null; then\n    echo \"Detected quota exhaustion in response body. Failing early.\"\n    exit 1\n  fi\n  now=$(date +%s)\n  elapsed=$((now-start))\n  echo \"Status=$status after ${elapsed}s. Retrying in ${INTERVAL_SECONDS}s...\"\n  if [[ $elapsed -ge ${TIMEOUT_SECONDS} ]]; then\n    echo \"Timed out after ${TIMEOUT_SECONDS}s waiting for healthy status.\"\n    cat /tmp/resp.json || true\n    exit 1\n  fi\n  sleep ${INTERVAL_SECONDS}\ndone\n"
