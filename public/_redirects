# Cloudflare Pages redirects file
# Let Astro middleware handle trailing slash redirects
# Only handle specific static pages that need explicit redirects

# API endpoints - redirect trailing slash to no trailing slash
/api/*/ /api/:splat 301

# Static pages
/privacy /privacy/ 301
/terms /terms/ 301
/data-deletion /data-deletion/ 301

# OAuth callback
/oauth/callback /oauth/callback/ 301

# Care-calculator (static directory)
/care-calculator /care-calculator/ 301