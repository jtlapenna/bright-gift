# Cloudflare Pages redirects file
# Redirect trailing slash URLs to non-trailing slash versions

# Blog posts
/blog/*/ /blog/:splat 301

# Category pages  
/category/*/ /category/:splat 301

# Static pages
/privacy/ /privacy 301
/terms/ /terms 301
/data-deletion/ /data-deletion 301

# OAuth callback
/oauth/callback/ /oauth/callback 301

# Catch-all for any other trailing slash URLs (except root)
/*/ /:splat 301